diff --git a/internal/store/scratch_tamper_test.go b/internal/store/scratch_tamper_test.go
new file mode 100644
index 0000000..8648b12
--- /dev/null
+++ b/internal/store/scratch_tamper_test.go
@@ -0,0 +1,64 @@
+package store
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+// TestChecksumIsFirstHexTokenInDBFile pins the on-disk layout property that
+// the A-104 acceptance draft depends on: after a clean open, write and close,
+// the recorded checksum is the FIRST 64-char lowercase-hex token in the raw
+// database file (at this schema size it is also the only one). The draft
+// byte-tampers the first such token and expects the next boot to refuse with
+// a checksum mismatch; this test proves that assumption at the store level,
+// without spawning the server.
+//
+// If a future migration stores earlier hex-looking data (e.g. UUID columns)
+// before the schema_migrations page, the first-token property can legitimately
+// change: update that migration's task consciously, and T-105's sanctioned
+// index pin is the fallback.
+func TestChecksumIsFirstHexTokenInDBFile(t *testing.T) {
+	ctx := context.Background()
+	path := filepath.Join(t.TempDir(), "layout.db")
+
+	db, err := Open(ctx, path)
+	if err != nil {
+		t.Fatalf("open: %v", err)
+	}
+	if _, err := db.ProbeInc(ctx); err != nil {
+		t.Fatalf("inc: %v", err)
+	}
+	var recorded string
+	if err := db.sql.QueryRowContext(ctx,
+		"SELECT sha256 FROM schema_migrations WHERE version = '0001_init'").Scan(&recorded); err != nil {
+		t.Fatalf("select recorded checksum: %v", err)
+	}
+	if err := db.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+
+	// A clean Close checkpoints and removes the -wal sidecar, leaving the
+	// checksum text in the main database file.
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read db file: %v", err)
+	}
+	re := regexp.MustCompile(`[0-9a-f]{64}`)
+	locs := re.FindAllIndex(data, -1)
+	if len(locs) == 0 {
+		t.Fatalf("no 64-char lowercase-hex token in the %d-byte database file", len(data))
+	}
+	first := string(data[locs[0][0]:locs[0][1]])
+	if first != recorded {
+		t.Fatalf("first hex token = %s, want the recorded checksum %s", first, recorded)
+	}
+	t.Logf("%d hex-64 token(s); first at offset %d is the recorded checksum", len(locs), locs[0][0])
+	if len(locs) > 1 {
+		t.Logf("note: additional hex tokens present: %s",
+			strings.Join([]string{string(data[locs[1][0]:locs[1][1]])}, ", "))
+	}
+}
diff --git a/internal/store/store.go b/internal/store/store.go
new file mode 100644
index 0000000..caafbb9
--- /dev/null
+++ b/internal/store/store.go
@@ -0,0 +1,100 @@
+// Package store owns the SQLite database: opening it with the right pragmas,
+// applying the embedded migrations under a checksum guard, and every query.
+// The public API (Open/Close/ProbeCount/ProbeInc) is frozen; other packages
+// compile against it.
+package store
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+
+	"github.com/amscotti/groveland-lights/internal/store/gen"
+
+	// Pure-Go SQLite driver (no cgo). Registers as "sqlite".
+	_ "modernc.org/sqlite"
+)
+
+// DB wraps one SQLite connection pool with the sqlc-generated queries.
+type DB struct {
+	sql *sql.DB
+	q   *gen.Queries
+}
+
+// dsn builds the driver DSN: WAL journal, 5s busy timeout and enforced
+// foreign keys on every pooled connection (these pragmas are per-connection,
+// so they must come from the DSN, not a one-off Exec).
+func dsn(dbPath string) string {
+	return "file:" + dbPath +
+		"?_pragma=journal_mode(WAL)" +
+		"&_pragma=busy_timeout(5000)" +
+		"&_pragma=foreign_keys(1)"
+}
+
+// Open opens (creating if necessary) the SQLite database at dbPath, applies
+// any not-yet-recorded migrations in filename order, and validates that every
+// already-recorded migration still has the checksum it was applied with. A
+// checksum mismatch returns an error naming the offending file: callers must
+// refuse to boot. Close the returned DB when done.
+func Open(ctx context.Context, dbPath string) (*DB, error) {
+	sqlDB, err := sql.Open("sqlite", dsn(dbPath))
+	if err != nil {
+		return nil, fmt.Errorf("store: open %s: %w", dbPath, err)
+	}
+	if err := sqlDB.PingContext(ctx); err != nil {
+		_ = sqlDB.Close()
+		return nil, fmt.Errorf("store: ping %s: %w", dbPath, err)
+	}
+	if err := applyMigrations(ctx, sqlDB, migrationsFS); err != nil {
+		_ = sqlDB.Close()
+		return nil, err
+	}
+	return &DB{sql: sqlDB, q: gen.New(sqlDB)}, nil
+}
+
+// Close releases the database pool. WAL data is checkpointed into the main
+// database file on the last connection close.
+func (db *DB) Close() error {
+	if err := db.sql.Close(); err != nil {
+		return fmt.Errorf("store: close: %w", err)
+	}
+	return nil
+}
+
+// ErrNotFound is returned when an expected row does not exist.
+var ErrNotFound = fmt.Errorf("store: not found")
+
+// ProbeCount returns the current probe counter value. It wraps ErrNotFound
+// if the seeded probe row is missing.
+func (db *DB) ProbeCount(ctx context.Context) (int64, error) {
+	n, err := db.q.ProbeCount(ctx)
+	if err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return 0, ErrNotFound
+		}
+		return 0, fmt.Errorf("store: probe count: %w", err)
+	}
+	return n, nil
+}
+
+// ProbeInc atomically increments the probe counter and returns the new value.
+// The UPDATE ... RETURNING runs inside a transaction, so concurrent callers
+// never lose an increment and each sees a distinct value.
+func (db *DB) ProbeInc(ctx context.Context) (int64, error) {
+	tx, err := db.sql.BeginTx(ctx, nil)
+	if err != nil {
+		return 0, fmt.Errorf("store: probe inc: begin: %w", err)
+	}
+	// Commit's error is authoritative; Rollback after a successful Commit is
+	// a harmless no-op returned by the driver.
+	defer func() { _ = tx.Rollback() }()
+	n, err := db.q.WithTx(tx).ProbeInc(ctx)
+	if err != nil {
+		return 0, fmt.Errorf("store: probe inc: %w", err)
+	}
+	if err := tx.Commit(); err != nil {
+		return 0, fmt.Errorf("store: probe inc: commit: %w", err)
+	}
+	return n, nil
+}
