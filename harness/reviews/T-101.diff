+// Code generated by sqlc. DO NOT EDIT.
+// versions:
+//   sqlc v1.31.1
+// source: probe.sql
+
+package gen
+
+import (
+	"context"
+)
+
+const probeCount = `-- name: ProbeCount :one
+
+SELECT n
+FROM probe
+WHERE id = 1
+`
+
+// Probe counter queries. The probe table is created by
+// migrations/0001_init.sql and always holds exactly one row (id = 1).
+func (q *Queries) ProbeCount(ctx context.Context) (int64, error) {
+	row := q.db.QueryRowContext(ctx, probeCount)
+	var n int64
+	err := row.Scan(&n)
+	return n, err
+}
+
+const probeInc = `-- name: ProbeInc :one
+UPDATE probe
+SET n = n + 1
+WHERE id = 1
+RETURNING n
+`
+
+func (q *Queries) ProbeInc(ctx context.Context) (int64, error) {
+	row := q.db.QueryRowContext(ctx, probeInc)
+	var n int64
+	err := row.Scan(&n)
+	return n, err
+}
