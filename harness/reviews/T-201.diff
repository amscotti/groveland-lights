+-- Light inventory queries. The lights table is created by
+-- migrations/0002_lights.sql; soft-deleted rows (deleted_at IS NULL filters)
+-- are invisible to every read and every edit, which is the A-208 store half.
+-- created_at/updated_at/deleted_at are RFC3339 TEXT stamped by the typed
+-- wrappers in internal/store/lights.go.
+
+-- name: CreateLight :one
+INSERT INTO lights (
+  asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  gml_pole_no, created_by, created_at, updated_at
+) VALUES (
+  sqlc.narg('asset_no'), sqlc.arg('kind'), sqlc.arg('label'), sqlc.arg('lat'),
+  sqlc.arg('lon'), sqlc.narg('accuracy_m'), sqlc.narg('photo_id'),
+  sqlc.narg('gml_pole_no'), sqlc.narg('created_by'),
+  sqlc.arg('created_at'), sqlc.arg('updated_at')
+)
+RETURNING id, asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  status, status_source, status_at, status_confirmed_at, gml_pole_no,
+  created_by, created_at, updated_at, deleted_at;
+
+-- name: GetLight :one
+SELECT id, asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  status, status_source, status_at, status_confirmed_at, gml_pole_no,
+  created_by, created_at, updated_at, deleted_at
+FROM lights
+WHERE id = ?1 AND deleted_at IS NULL;
+
+-- name: GetLightByAssetNo :one
+SELECT id, asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  status, status_source, status_at, status_confirmed_at, gml_pole_no,
+  created_by, created_at, updated_at, deleted_at
+FROM lights
+WHERE asset_no = ?1 AND deleted_at IS NULL;
+
+-- name: ListRecentLights :many
+SELECT id, asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  status, status_source, status_at, status_confirmed_at, gml_pole_no,
+  created_by, created_at, updated_at, deleted_at
+FROM lights
+WHERE deleted_at IS NULL
+ORDER BY created_at DESC, id DESC
+LIMIT ?1 OFFSET ?2;
+
+-- name: UpdateLight :one
+UPDATE lights
+SET label = ?1, asset_no = ?2, updated_at = ?3
+WHERE id = ?4 AND deleted_at IS NULL
+RETURNING id, asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  status, status_source, status_at, status_confirmed_at, gml_pole_no,
+  created_by, created_at, updated_at, deleted_at;
+
+-- name: SoftDeleteLight :one
+UPDATE lights
+SET deleted_at = ?1
+WHERE id = ?2 AND deleted_at IS NULL
+RETURNING id;
+
+-- name: NearbyLights :many
+SELECT id, asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  status, status_source, status_at, status_confirmed_at, gml_pole_no,
+  created_by, created_at, updated_at, deleted_at
+FROM lights
+WHERE deleted_at IS NULL
+  AND lat >= sqlc.arg('min_lat') AND lat <= sqlc.arg('max_lat')
+  AND lon >= sqlc.arg('min_lon') AND lon <= sqlc.arg('max_lon')
+ORDER BY created_at DESC, id DESC;
diff --git a/internal/store/queries/photos.sql b/internal/store/queries/photos.sql
new file mode 100644
index 0000000..c7fa31b
--- /dev/null
+++ b/internal/store/queries/photos.sql
@@ -0,0 +1,21 @@
+-- Photo metadata queries. The photos table is created by
+-- migrations/0002_lights.sql; the photo BLOB itself lives in PHOTO_DIR on
+-- disk, the row only records the stored path and processed dimensions.
+-- owner_id stays NULL until the auth slice (hand-written database/sql in the
+-- session/user store files) begins attaching photos to user accounts.
+
+-- name: CreatePhoto :one
+INSERT INTO photos (path, width, height, bytes, sha256, created_at)
+VALUES (?1, ?2, ?3, ?4, ?5, ?6)
+RETURNING id, owner_id, path, width, height, bytes, sha256, created_at;
+
+-- name: GetPhoto :one
+SELECT id, owner_id, path, width, height, bytes, sha256, created_at
+FROM photos
+WHERE id = ?1;
+
+-- name: ListPhotos :many
+SELECT id, owner_id, path, width, height, bytes, sha256, created_at
+FROM photos
+ORDER BY id
+LIMIT ?1;
diff --git a/migrations/0002_lights.sql b/migrations/0002_lights.sql
new file mode 100644
