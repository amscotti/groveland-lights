+	err := row.Scan(
+		&i.ID,
+		&i.AssetNo,
+		&i.Kind,
+		&i.Label,
+		&i.Lat,
+		&i.Lon,
+		&i.AccuracyM,
+		&i.PhotoID,
+		&i.Status,
+		&i.StatusSource,
+		&i.StatusAt,
+		&i.StatusConfirmedAt,
+		&i.GmlPoleNo,
+		&i.CreatedBy,
+		&i.CreatedAt,
+		&i.UpdatedAt,
+		&i.DeletedAt,
+	)
+	return i, err
+}
+
+const getLight = `-- name: GetLight :one
+SELECT id, asset_no, kind, label, lat, lon, accuracy_m, photo_id,
+  status, status_source, status_at, status_confirmed_at, gml_pole_no,
+  created_by, created_at, updated_at, deleted_at
+FROM lights
+WHERE id = ?1 AND deleted_at IS NULL
+`
+
+func (q *Queries) GetLight(ctx context.Context, id int64) (Light, error) {
+	row := q.db.QueryRowContext(ctx, getLight, id)
+	var i Light
+	err := row.Scan(
