+// grovelandLat/Lon are the acceptance drafts' illustrative fixture
+// coordinates (inside TOWN_BBOX); the duplicate tests build their offsets
+// around this point.
+const (
+	grovelandLat = 42.7617
+	grovelandLon = -71.0303
