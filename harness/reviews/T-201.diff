+	if len(page1) != 3 || len(page2) != 2 {
+		t.Fatalf("page sizes = (%d, %d), want (3, 2)", len(page1), len(page2))
+	}
+	seen := map[LightID]bool{}
+	for _, l := range append(append([]Light{}, page1...), page2...) {
+		if seen[l.ID] {
+			t.Fatalf("id %d appears on both pages", l.ID)
