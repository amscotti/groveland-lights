@@ -0,0 +1,218 @@
+package store
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"testing"
+	"time"
+)
+
+// clockBase is the fixed instant the injected-clock tests walk around.
+var clockBase = time.Date(2026, 11, 13, 12, 0, 0, 0, time.UTC)
+
+// setClock swaps the auth slice's clock for a fixed one and restores the
+// real clock on cleanup, so no test can leave a frozen clock behind.
+func setClock(t *testing.T, at time.Time) {
+	t.Helper()
+	prev := Now
+	Now = func() time.Time { return at }
+	t.Cleanup(func() { Now = prev })
+}
+
+// TestCreateSessionRoundTrip covers the session lifecycle as a table of
+// flows; case names are the assertions.
+func TestCreateSessionRoundTrip(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"created session validates with its user and role", func(t *testing.T) {
+			db, _ := openFresh(t)
+			ctx := context.Background()
+			uid, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser: %v", err)
+			}
+			id, err := db.CreateSession(ctx, uid, "admin")
+			if err != nil {
+				t.Fatalf("CreateSession: %v", err)
+			}
+			gotUID, gotRole, ok, err := db.SessionValid(ctx, id)
+			if err != nil {
+				t.Fatalf("SessionValid: %v", err)
+			}
+			if !ok {
+				t.Fatal("SessionValid = false for a freshly created session")
+			}
+			if gotUID != uid {
+				t.Fatalf("SessionValid user = %d, want %d", gotUID, uid)
+			}
+			if gotRole != "admin" {
+				t.Fatalf("SessionValid role = %q, want admin", gotRole)
+			}
+		}},
+		{"session id is 32 random bytes base64url and unique per create", func(t *testing.T) {
+			db, _ := openFresh(t)
+			ctx := context.Background()
+			uid, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser: %v", err)
+			}
+			a, err := db.CreateSession(ctx, uid, "admin")
+			if err != nil {
+				t.Fatalf("CreateSession: %v", err)
+			}
+			b, err := db.CreateSession(ctx, uid, "admin")
+			if err != nil {
+				t.Fatalf("CreateSession #2: %v", err)
+			}
+			if a == b {
+				t.Fatal("two creates returned the same session id")
+			}
+			raw, err := base64.RawURLEncoding.DecodeString(a)
+			if err != nil {
+				t.Fatalf("session id not base64url: %v", err)
+			}
+			if len(raw) != sessionIDBytes {
+				t.Fatalf("session id carries %d bytes, want %d", len(raw), sessionIDBytes)
+			}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestCreateSessionTimestamps pins the stored stamps against the injected
+// clock: created_at now, expires_at now+24h (the frozen session lifetime).
+func TestCreateSessionTimestamps(t *testing.T) {
+	db, _ := openFresh(t)
+	setClock(t, clockBase)
+	ctx := context.Background()
+	uid, err := db.EnsureAdminUser(ctx)
+	if err != nil {
+		t.Fatalf("EnsureAdminUser: %v", err)
+	}
+	id, err := db.CreateSession(ctx, uid, "admin")
+	if err != nil {
+		t.Fatalf("CreateSession: %v", err)
+	}
+	var createdAt, expiresAt string
+	if err := db.sql.QueryRowContext(ctx,
+		`SELECT created_at, expires_at FROM sessions WHERE id = ?`, id).
+		Scan(&createdAt, &expiresAt); err != nil {
+		t.Fatalf("select session row: %v", err)
+	}
+	if createdAt != clockBase.Format(time.RFC3339) {
+		t.Fatalf("created_at = %q, want %q", createdAt, clockBase.Format(time.RFC3339))
+	}
+	if expiresAt != clockBase.Add(sessionTTL).Format(time.RFC3339) {
+		t.Fatalf("expires_at = %q, want %q", expiresAt, clockBase.Add(sessionTTL).Format(time.RFC3339))
+	}
+}
+
+// TestSessionRejectionPaths covers the not-valid paths and the delete
+// lifecycle; case names are the assertions.
+func TestSessionRejectionPaths(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"unknown id is not valid and carries no error", func(t *testing.T) {
+			db, _ := openFresh(t)
+			_, _, ok, err := db.SessionValid(context.Background(), "no-such-session")
+			if err != nil {
+				t.Fatalf("SessionValid: %v", err)
+			}
+			if ok {
+				t.Fatal("SessionValid = true for an unknown id")
+			}
+		}},
+		{"empty id is not valid and carries no error", func(t *testing.T) {
+			db, _ := openFresh(t)
+			_, _, ok, err := db.SessionValid(context.Background(), "")
+			if err != nil {
+				t.Fatalf("SessionValid: %v", err)
+			}
+			if ok {
+				t.Fatal("SessionValid = true for an empty id")
+			}
+		}},
+		{"delete removes the session and is idempotent", func(t *testing.T) {
+			db, _ := openFresh(t)
+			ctx := context.Background()
+			uid, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser: %v", err)
+			}
+			id, err := db.CreateSession(ctx, uid, "admin")
+			if err != nil {
+				t.Fatalf("CreateSession: %v", err)
+			}
+			if err := db.DeleteSession(ctx, id); err != nil {
+				t.Fatalf("DeleteSession: %v", err)
+			}
+			if _, _, ok, _ := db.SessionValid(ctx, id); ok {
+				t.Fatal("SessionValid = true after DeleteSession")
+			}
+			if err := db.DeleteSession(ctx, id); err != nil {
+				t.Fatalf("DeleteSession (again): %v", err)
+			}
+		}},
+		{"foreign key refuses a session for an unknown user", func(t *testing.T) {
+			db, _ := openFresh(t)
+			_, err := db.CreateSession(context.Background(), UserID(9999), "admin")
+			if err == nil {
+				t.Fatal("CreateSession for unknown user succeeded, want an FK error")
+			}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestSessionExpiryBoundary walks the frozen 24h expiry with the injected
+// clock: valid up to expires_at-1s, rejected from expires_at onwards.
+func TestSessionExpiryBoundary(t *testing.T) {
+	tests := []struct {
+		name    string
+		offset  time.Duration
+		wantOK  bool
+		wantErr error // non-nil when the rejection must carry this sentinel
+	}{
+		{"valid just before expiry", sessionTTL - time.Second, true, nil},
+		{"invalid exactly at expiry", sessionTTL, false, ErrBadCredentials},
+		{"invalid after expiry", sessionTTL + time.Hour, false, ErrBadCredentials},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			db, _ := openFresh(t)
+			setClock(t, clockBase)
+			ctx := context.Background()
+			uid, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser: %v", err)
+			}
+			id, err := db.CreateSession(ctx, uid, "admin")
+			if err != nil {
+				t.Fatalf("CreateSession: %v", err)
+			}
+			setClock(t, clockBase.Add(tc.offset))
+			_, _, ok, err := db.SessionValid(ctx, id)
+			if ok != tc.wantOK {
+				t.Fatalf("SessionValid ok = %v, want %v", ok, tc.wantOK)
+			}
+			if tc.wantErr == nil {
+				if err != nil {
+					t.Fatalf("SessionValid err = %v, want nil", err)
+				}
+				return
+			}
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("SessionValid err = %v, want it to wrap %v", err, tc.wantErr)
+			}
+		})
+	}
+}
diff --git a/internal/store/user.go b/internal/store/user.go
new file mode 100644
index 0000000..2585c24
--- /dev/null
+++ b/internal/store/user.go
@@ -0,0 +1,108 @@
+package store
+
+// Admin identity and the one-time ADMIN_TOKEN exchange (A-201). The login
+// flow (internal/web/auth.go) first compares the presented token against the
+// configured ADMIN_TOKEN, then consumes it here: the login_tokens row is the
+// global, server-side one-time record, so a replay from any client is
+// refused even with a fresh cookie jar.
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"time"
+)
+
+// UserID identifies one row of the users table (typed so a session or photo
+// reference can never be confused with another id at compile time).
+type UserID int64
+
+const (
+	// adminHandle is the single admin account's handle. The town has one
+	// admin; the row is created lazily on first token exchange.
+	adminHandle = "admin"
+
+	// adminEmail is the contact recorded on the admin user row and on every
+	// consumed login token row (login_tokens.email is NOT NULL).
+	adminEmail = "admin"
+)
+
+// loginTokenTTL is how long a consumed token row stays recorded (the row is
+// the replay record, so expiry only bounds housekeeping, not the one-time
+// rule: a consumed token never validates again regardless of age).
+const loginTokenTTL = 24 * time.Hour
+
+// ErrTokenReused reports a replayed one-time login token: the token_hash row
+// already exists with used_at set. Callers answer 403 without revealing
+// whether the presented token was otherwise correct.
+var ErrTokenReused = errors.New("store: login token already used")
+
+// EnsureAdminUser idempotently ensures the admin account exists and returns
+// its id: INSERT ... ON CONFLICT(handle) DO NOTHING followed by the SELECT,
+// so the first exchange creates the row and every later call returns the
+// same id.
+func (db *DB) EnsureAdminUser(ctx context.Context) (UserID, error) {
+	if _, err := db.sql.ExecContext(ctx, `
+		INSERT INTO users (handle, email, role, created_at)
+		VALUES (?, ?, 'admin', ?)
+		ON CONFLICT(handle) DO NOTHING`,
+		adminHandle, adminEmail, Now().Format(time.RFC3339)); err != nil {
+		return 0, fmt.Errorf("store: ensure admin user: %w", err)
+	}
+	var id int64
+	if err := db.sql.QueryRowContext(ctx,
+		`SELECT id FROM users WHERE handle = ?`, adminHandle).Scan(&id); err != nil {
+		return 0, fmt.Errorf("store: ensure admin user: select: %w", err)
+	}
+	return UserID(id), nil
+}
+
+// ConsumeAdminToken records the one-time use of the admin login token. The
+// first call inserts the login_tokens row (token_hash = hex(sha256(token)),
+// email admin, expires_at now+24h, used_at now) and succeeds; a second call
+// for the same token finds used_at set and wraps ErrTokenReused. Any other
+// database failure is wrapped with %w. Consumption is global and permanent:
+// it does not depend on which client presents the token and does not lapse
+// when the row's expires_at passes.
+func (db *DB) ConsumeAdminToken(ctx context.Context, token []byte) error {
+	sum := sha256.Sum256(token)
+	tokenHash := hex.EncodeToString(sum[:])
+	stamp := Now()
+	_, err := db.sql.ExecContext(ctx, `
+		INSERT INTO login_tokens (token_hash, email, expires_at, used_at)
+		VALUES (?, ?, ?, ?)`,
+		tokenHash, adminEmail,
+		stamp.Add(loginTokenTTL).Format(time.RFC3339),
+		stamp.Format(time.RFC3339))
+	if err == nil {
+		return nil
+	}
+	// The INSERT can only conflict on the token_hash primary key: the token
+	// was consumed before. Confirm through the stored row so a driver-level
+	// failure is never misread as a replay (and vice versa).
+	var usedAt sql.NullString
+	qerr := db.sql.QueryRowContext(ctx,
+		`SELECT used_at FROM login_tokens WHERE token_hash = ?`, tokenHash).Scan(&usedAt)
+	switch {
+	case qerr == nil && usedAt.Valid:
+		return fmt.Errorf("store: consume admin token: %w", ErrTokenReused)
+	case qerr == nil:
+		// A row exists but was never marked used — unreachable through this
+		// API (used_at is stamped at insert time). Consume it now so the
+		// first use still wins exactly once.
+		if _, uerr := db.sql.ExecContext(ctx,
+			`UPDATE login_tokens SET used_at = ? WHERE token_hash = ? AND used_at IS NULL`,
+			stamp.Format(time.RFC3339), tokenHash); uerr != nil {
+			return fmt.Errorf("store: consume admin token: %w", uerr)
+		}
+		return nil
+	case errors.Is(qerr, sql.ErrNoRows):
+		// The INSERT failed without storing anything: a real database error.
+		return fmt.Errorf("store: consume admin token: %w", err)
+	default:
+		return fmt.Errorf("store: consume admin token: %w", qerr)
+	}
+}
diff --git a/internal/store/user_test.go b/internal/store/user_test.go
new file mode 100644
index 0000000..6d2072d
--- /dev/null
+++ b/internal/store/user_test.go
@@ -0,0 +1,149 @@
+package store
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"testing"
+	"time"
+)
+
+// TestEnsureAdminUser covers the idempotent admin-account creation; case
+// names are the assertions.
+func TestEnsureAdminUser(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"first call creates the admin row", func(t *testing.T) {
+			db, _ := openFresh(t)
+			id, err := db.EnsureAdminUser(context.Background())
+			if err != nil {
+				t.Fatalf("EnsureAdminUser: %v", err)
+			}
+			if id <= 0 {
+				t.Fatalf("EnsureAdminUser id = %d, want > 0", id)
+			}
+			var handle, email, role string
+			if err := db.sql.QueryRowContext(context.Background(),
+				`SELECT handle, email, role FROM users WHERE id = ?`, int64(id)).
+				Scan(&handle, &email, &role); err != nil {
+				t.Fatalf("select admin row: %v", err)
+			}
+			if handle != adminHandle || email != adminEmail || role != "admin" {
+				t.Fatalf("admin row = (%q, %q, %q), want (%q, %q, admin)",
+					handle, email, role, adminHandle, adminEmail)
+			}
+		}},
+		{"second call is idempotent and returns the same id", func(t *testing.T) {
+			db, _ := openFresh(t)
+			ctx := context.Background()
+			first, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser #1: %v", err)
+			}
+			second, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser #2: %v", err)
+			}
+			if first != second {
+				t.Fatalf("EnsureAdminUser ids differ: %d then %d", first, second)
+			}
+			var n int
+			if err := db.sql.QueryRowContext(ctx,
+				`SELECT count(*) FROM users WHERE handle = ?`, adminHandle).Scan(&n); err != nil {
+				t.Fatalf("count users: %v", err)
+			}
+			if n != 1 {
+				t.Fatalf("users with handle %q = %d, want exactly 1", adminHandle, n)
+			}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestConsumeAdminToken covers the one-time token exchange; case names are
+// the assertions.
+func TestConsumeAdminToken(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"first use succeeds", func(t *testing.T) {
+			db, _ := openFresh(t)
+			if err := db.ConsumeAdminToken(context.Background(), []byte("the-admin-token")); err != nil {
+				t.Fatalf("ConsumeAdminToken: %v", err)
+			}
+		}},
+		{"second use wraps ErrTokenReused", func(t *testing.T) {
+			db, _ := openFresh(t)
+			ctx := context.Background()
+			token := []byte("the-admin-token")
+			if err := db.ConsumeAdminToken(ctx, token); err != nil {
+				t.Fatalf("first ConsumeAdminToken: %v", err)
+			}
+			err := db.ConsumeAdminToken(ctx, token)
+			if !errors.Is(err, ErrTokenReused) {
+				t.Fatalf("second ConsumeAdminToken err = %v, want it to wrap ErrTokenReused", err)
+			}
+		}},
+		{"stored row records email, 24h expiry and the use stamp", func(t *testing.T) {
+			db, _ := openFresh(t)
+			setClock(t, clockBase)
+			token := []byte("the-admin-token")
+			if err := db.ConsumeAdminToken(context.Background(), token); err != nil {
+				t.Fatalf("ConsumeAdminToken: %v", err)
+			}
+			var email, expiresAt, usedAt string
+			if err := db.sql.QueryRowContext(context.Background(),
+				`SELECT email, expires_at, used_at FROM login_tokens WHERE token_hash = ?`,
+				tokenHashOf(token)).Scan(&email, &expiresAt, &usedAt); err != nil {
+				t.Fatalf("select login_tokens row: %v", err)
+			}
+			if email != adminEmail {
+				t.Fatalf("email = %q, want %q", email, adminEmail)
+			}
+			if expiresAt != clockBase.Add(loginTokenTTL).Format(time.RFC3339) {
+				t.Fatalf("expires_at = %q, want %q", expiresAt, clockBase.Add(loginTokenTTL).Format(time.RFC3339))
+			}
+			if usedAt != clockBase.Format(time.RFC3339) {
+				t.Fatalf("used_at = %q, want %q", usedAt, clockBase.Format(time.RFC3339))
+			}
+		}},
+		{"a different token value is independent", func(t *testing.T) {
+			db, _ := openFresh(t)
+			ctx := context.Background()
+			if err := db.ConsumeAdminToken(ctx, []byte("token-a")); err != nil {
+				t.Fatalf("ConsumeAdminToken A: %v", err)
+			}
+			if err := db.ConsumeAdminToken(ctx, []byte("token-b")); err != nil {
+				t.Fatalf("ConsumeAdminToken B: %v", err)
+			}
+		}},
+		{"database errors wrap the driver error", func(t *testing.T) {
+			db, _ := openFresh(t)
+			if err := db.Close(); err != nil {
+				t.Fatalf("Close: %v", err)
+			}
+			err := db.ConsumeAdminToken(context.Background(), []byte("the-admin-token"))
+			if err == nil {
+				t.Fatal("ConsumeAdminToken on a closed DB succeeded, want an error")
+			}
+			if errors.Is(err, ErrTokenReused) {
+				t.Fatalf("database error misreported as a replay: %v", err)
+			}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// tokenHashOf mirrors ConsumeAdminToken's hash derivation for test queries.
+func tokenHashOf(token []byte) string {
+	sum := sha256.Sum256(token)
+	return hex.EncodeToString(sum[:])
+}
diff --git a/internal/web/auth.go b/internal/web/auth.go
new file mode 100644
index 0000000..921402f
--- /dev/null
+++ b/internal/web/auth.go
@@ -0,0 +1,179 @@
+package web
+
+// Admin login: one-time ADMIN_TOKEN exchange for an admin session (A-201).
+// The frozen flow (acceptance/drafts/admin_auth_go_test.go.txt):
+//
+//	GET  /admin/login                  -> 200 form page (no/blank token)
+//	GET  /admin/login?token=<wrong>    -> 403
+//	GET  /admin/login?token=<valid>    -> 302 /admin + gl_session cookie
+//	GET  (replay, any client)          -> 403 (consumption is server-side)
+//	POST /admin/login                  -> the same exchange, CSRF-verified
+//
+// auth.go owns the routes and the exchange; session.go owns the cookie and
+// the AdminOnly guard. The page below is the minimal contract markup only;
+// the template pipeline render is T-205's (pages/admin-login.html, replacing
+// this inline page WITHOUT changing the frozen strings).
+
+import (
+	"bytes"
+	"crypto/subtle"
+	"encoding/base64"
+	"errors"
+	"html/template"
+	"net/http"
+
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+func init() {
+	register(route{pattern: "GET /admin/login", handler: adminLoginGet})
+	register(route{pattern: "POST /admin/login", handler: adminLoginPost})
+}
+
+// loginForm is one login request parsed at the boundary; the handlers below
+// consult only these typed fields and never touch the form or query again.
+type loginForm struct {
+	Token     string // the submitted (or queried) admin token
+	CSRFToken string // POST only: the double-submit csrf_token field
+}
+
+// parseLoginGet lifts the GET query into a loginForm.
+func parseLoginGet(r *http.Request) loginForm {
+	return loginForm{Token: r.URL.Query().Get("token")}
+}
+
+// parseLoginPost parses the POST form exactly once and lifts it into a
+// loginForm.
+func parseLoginPost(r *http.Request) (loginForm, error) {
+	if err := r.ParseForm(); err != nil {
+		return loginForm{}, err
+	}
+	return loginForm{
+		Token:     r.PostForm.Get("token"),
+		CSRFToken: r.PostForm.Get(CSRFTokenName),
+	}, nil
+}
+
+func adminLoginGet(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	s.adminLogin(w, r, parseLoginGet(r))
+}
+
+func adminLoginPost(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	form, err := parseLoginPost(r)
+	if err != nil {
+		s.Log.Error("admin login: parse", "err", err)
+		http.Error(w, "bad request", http.StatusBadRequest)
+		return
+	}
+	if err := VerifyCSRF(r, form.CSRFToken); err != nil {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return
+	}
+	s.adminLogin(w, r, form)
+}
+
+// tokenMatches reports whether the submitted token is the configured admin
+// credential in either of its two operator-facing forms. ADMIN_TOKEN is
+// provisioned as base64 (docs/PLAN.md env table), and config.Load stores the
+// DECODED bytes in Cfg.AdminToken — while the operator and the frozen A-201
+// flow present the env value verbatim, i.e. the base64 encoding of exactly
+// those bytes. Both strings therefore denote one and the same secret, so
+// both encodings are accepted; that widens nothing (anyone who can compute
+// the encoding already knows the secret). Both comparisons run
+// unconditionally and constant-time.
+func tokenMatches(submitted string, admin []byte) bool {
+	encoded := base64.StdEncoding.EncodeToString(admin)
+	mDecoded := subtle.ConstantTimeCompare([]byte(submitted), admin)
+	mEncoded := subtle.ConstantTimeCompare([]byte(submitted), []byte(encoded))
+	return mDecoded == 1 || mEncoded == 1
+}
+
+// adminLogin runs the shared exchange for a parsed form. A blank token
+// renders the form page (the contract's no/blank -> 200); a wrong token is a
+// uniform 403; a valid one is consumed globally and exchanged for an admin
+// session cookie with a 302 to /admin. The token value is never logged.
+func (s *Server) adminLogin(w http.ResponseWriter, r *http.Request, form loginForm) {
+	if form.Token == "" {
+		s.renderLoginPage(w)
+		return
+	}
+	if s.Store == nil {
+		s.Log.Error("admin login: store not wired")
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	// Uniform constant-time comparison against the configured ADMIN_TOKEN
+	// (in either operator-facing encoding; see tokenMatches). On success the
+	// canonical config bytes are what gets consumed below, so every accepted
+	// encoding burns the same one-time row.
+	if !tokenMatches(form.Token, s.Cfg.AdminToken) {
+		s.Log.Info("admin login: token rejected")
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return
+	}
+	if err := s.Store.ConsumeAdminToken(r.Context(), s.Cfg.AdminToken); err != nil {
+		if errors.Is(err, store.ErrTokenReused) {
+			s.Log.Info("admin login: token replay refused")
+			http.Error(w, "forbidden", http.StatusForbidden)
+			return
+		}
+		s.Log.Error("admin login: consume token", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	uid, err := s.Store.EnsureAdminUser(r.Context())
+	if err != nil {
+		s.Log.Error("admin login: ensure admin user", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	sid, err := s.Store.CreateSession(r.Context(), uid, "admin")
+	if err != nil {
+		s.Log.Error("admin login: create session", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	setSessionCookie(s.Cfg, w, sid)
+	s.Log.Info("admin login: session issued", "user_id", int64(uid))
+	http.Redirect(w, r, "/admin", http.StatusFound)
+}
+
+// loginPageTmpl is the minimal login page: exactly the frozen contract
+// markup (heading "Admin login", label "Token" over input name "token",
+// button "Sign in"). T-205 replaces it with pages/admin-login.html through
+// the template pipeline, keeping these strings byte-for-byte.
+var loginPageTmpl = template.Must(template.New("admin-login").Parse(`<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Admin login — Groveland Lights</title>
+</head>
+<body>
+<main>
+<h1>Admin login</h1>
+<form method="get" action="/admin/login">
+<label for="token">Token</label>
+<input id="token" name="token" type="password" autocomplete="off" required>
+<button type="submit">Sign in</button>
+</form>
+</main>
+</body>
+</html>
+`))
+
+// renderLoginPage answers 200 with the frozen login form. The template is
+// static (no data), so it is rendered into a buffer: a failure can never
+// half-write the response.
+func (s *Server) renderLoginPage(w http.ResponseWriter) {
+	var buf bytes.Buffer
+	if err := loginPageTmpl.Execute(&buf, nil); err != nil {
+		s.Log.Error("admin login: render", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	_, _ = w.Write(buf.Bytes())
+}
diff --git a/internal/web/auth_test.go b/internal/web/auth_test.go
new file mode 100644
index 0000000..d50cec7
--- /dev/null
+++ b/internal/web/auth_test.go
@@ -0,0 +1,353 @@
+package web
+
+import (
+	"context"
+	"encoding/base64"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/amscotti/groveland-lights/internal/config"
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+// authAdminToken is the ADMIN_TOKEN the auth tests configure; the frozen
+// exchange compares every submission against exactly this value.
+const authAdminToken = "baseline-test-admin-token"
+
+// authSessionKey is the signing key for the auth tests' cookies (32 bytes).
+var authSessionKey = []byte("0123456789abcdef0123456789abcdef")
+
+// The frozen login-page markup (mirrors the acceptance draft's regexes).
+var (
+	authReHeading = regexp.MustCompile(`<h1[^>]*>\s*Admin login\s*</h1>`)
+	authReLabel   = regexp.MustCompile(`<label[^>]*>\s*Token\s*</label>`)
+	authReInput   = regexp.MustCompile(`<input[^>]*name="token"[^>]*>`)
+	authReButton  = regexp.MustCompile(`<button[^>]*>\s*Sign in\s*</button>`)
+)
+
+// newAuthServer builds a Server wired to a real temp-file store (migrations
+// applied by store.Open) with a known ADMIN_TOKEN and signing key, exactly
+// the way main wires web.New(cfg, log, db).
+func newAuthServer(t *testing.T, env config.Env) (*Server, *store.DB) {
+	t.Helper()
+	db, err := store.Open(context.Background(), filepath.Join(t.TempDir(), "auth.db"))
+	if err != nil {
+		t.Fatalf("store.Open: %v", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	cfg := testConfig(env)
+	cfg.AdminToken = []byte(authAdminToken)
+	cfg.SessionKey = authSessionKey
+	s, err := New(cfg, slog.New(slog.NewTextHandler(io.Discard, nil)), db)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return s, db
+}
+
+// authGet runs a GET through the full middleware chain and returns the
+// recorder (redirects stay observable: ServeHTTP never follows them).
+func authGet(t *testing.T, s *Server, target string, hx bool) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequestWithContext(context.Background(), http.MethodGet, target, nil)
+	if hx {
+		req.Header.Set("HX-Request", "true")
+	}
+	rec := httptest.NewRecorder()
+	s.Handler().ServeHTTP(rec, req)
+	return rec
+}
+
+// authPostForm runs a urlencoded POST through the full middleware chain,
+// optionally carrying the csrf_token cookie.
+func authPostForm(t *testing.T, s *Server, target, csrfCookie string, form url.Values) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequestWithContext(context.Background(), http.MethodPost, target, strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	if csrfCookie != "" {
+		req.AddCookie(&http.Cookie{Name: CSRFTokenName, Value: csrfCookie})
+	}
+	rec := httptest.NewRecorder()
+	s.Handler().ServeHTTP(rec, req)
+	return rec
+}
+
+// sessionCookieOf extracts the gl_session cookie from a response, failing
+// the test when it is absent.
+func sessionCookieOf(t *testing.T, rec *httptest.ResponseRecorder) *http.Cookie {
+	t.Helper()
+	res := rec.Result()
+	defer func() { _ = res.Body.Close() }()
+	for _, c := range res.Cookies() {
+		if c.Name == SessionCookieName {
+			return c
+		}
+	}
+	t.Fatalf("response set no %s cookie; Set-Cookie: %v", SessionCookieName, res.Header.Values("Set-Cookie"))
+	return nil // unreachable
+}
+
+// assertLoginMarkup fails unless the body carries all four frozen elements.
+func assertLoginMarkup(t *testing.T, body string) {
+	t.Helper()
+	for _, re := range []*regexp.Regexp{authReHeading, authReLabel, authReInput, authReButton} {
+		if !re.MatchString(body) {
+			t.Errorf("login page missing the frozen %q element; body:\n%s", re.String(), body)
+		}
+	}
+}
+
+// assertFrozenCookieFlags checks the exact attribute set the A-201 draft
+// parses and compares: Path=/, Max-Age=86400, HttpOnly, SameSite=Lax, with
+// Secure exactly in prod.
+func assertFrozenCookieFlags(t *testing.T, c *http.Cookie, env config.Env) {
+	t.Helper()
+	if c.Path != "/" {
+		t.Errorf("cookie Path = %q, want exactly \"/\"", c.Path)
+	}
+	if c.MaxAge != 86400 {
+		t.Errorf("cookie Max-Age = %d, want 86400 (24 h)", c.MaxAge)
+	}
+	if !c.HttpOnly {
+		t.Error("cookie lacks the HttpOnly flag")
+	}
+	if c.SameSite != http.SameSiteLaxMode {
+		t.Errorf("cookie SameSite = %v, want Lax", c.SameSite)
+	}
+	if want := env == config.EnvProd; c.Secure != want {
+		t.Errorf("cookie Secure = %v, want %v (env %s)", c.Secure, want, env)
+	}
+}
+
+// assertRedirectToLogin asserts the full-page guard refusal: 302 with
+// Location /admin/login and the guarded handler's body never written.
+func assertRedirectToLogin(t *testing.T, rec *httptest.ResponseRecorder) {
+	t.Helper()
+	if rec.Code != http.StatusFound {
+		t.Fatalf("guard status = %d, want 302; body:\n%s", rec.Code, rec.Body.String())
+	}
+	if loc := rec.Header().Get("Location"); loc != "/admin/login" {
+		t.Fatalf("guard Location = %q, want %q", loc, "/admin/login")
+	}
+	if strings.Contains(rec.Body.String(), "admin-ok") {
+		t.Fatal("guarded handler ran despite the refusal")
+	}
+}
+
+// mustCSRFToken mints a CSRF token for the POST tests, failing on error.
+func mustCSRFToken(t *testing.T) string {
+	t.Helper()
+	tok, err := newCSRFToken()
+	if err != nil {
+		t.Fatalf("newCSRFToken: %v", err)
+	}
+	return tok
+}
+
+// TestAdminLoginExchange covers the frozen one-time exchange happy path:
+// the valid token mints a live admin session and redirects.
+func TestAdminLoginExchange(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"valid token first use sets session and redirects", func(t *testing.T) {
+			s, db := newAuthServer(t, config.EnvTest)
+			rec := authGet(t, s, "/admin/login?token="+authAdminToken, false)
+			if rec.Code != http.StatusFound {
+				t.Fatalf("status = %d, want 302; body:\n%s", rec.Code, rec.Body.String())
+			}
+			if loc := rec.Header().Get("Location"); loc != "/admin" {
+				t.Fatalf("Location = %q, want %q", loc, "/admin")
+			}
+			c := sessionCookieOf(t, rec)
+			assertFrozenCookieFlags(t, c, config.EnvTest)
+			// The cookie value must verify and name a live admin session.
+			id, ok := sessionIDOf(authSessionKey, c.Value)
+			if !ok {
+				t.Fatalf("minted cookie value %q does not verify", c.Value)
+			}
+			uid, role, valid, err := db.SessionValid(context.Background(), id)
+			if err != nil || !valid {
+				t.Fatalf("minted session %q not valid: ok=%v err=%v", id, valid, err)
+			}
+			if role != "admin" {
+				t.Fatalf("minted session role = %q, want admin", role)
+			}
+			if uid <= 0 {
+				t.Fatalf("minted session user id = %d, want > 0", uid)
+			}
+		}},
+		{"prod minted cookie is Secure", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvProd)
+			rec := authGet(t, s, "/admin/login?token="+authAdminToken, false)
+			if rec.Code != http.StatusFound {
+				t.Fatalf("status = %d, want 302", rec.Code)
+			}
+			assertFrozenCookieFlags(t, sessionCookieOf(t, rec), config.EnvProd)
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestAdminLoginRejections covers the refusal paths of the exchange; case
+// names are the assertions.
+func TestAdminLoginRejections(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"wrong token 403", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			rec := authGet(t, s, "/admin/login?token=definitely-not-the-token", false)
+			if rec.Code != http.StatusForbidden {
+				t.Fatalf("status = %d, want 403; body:\n%s", rec.Code, rec.Body.String())
+			}
+			// A refusal must not mint a session or set any cookie.
+			res := rec.Result()
+			defer func() { _ = res.Body.Close() }()
+			if n := len(res.Cookies()); n != 0 {
+				t.Errorf("wrong-token 403 set %d cookie(s), want 0", n)
+			}
+		}},
+		{"replayed token 403 from a fresh cookie-less client", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			first := authGet(t, s, "/admin/login?token="+authAdminToken, false)
+			if first.Code != http.StatusFound {
+				t.Fatalf("first exchange status = %d, want 302", first.Code)
+			}
+			// A brand-new request with NO cookies: the one-time property is
+			// server-side (login_tokens), so a fresh client must not help.
+			second := authGet(t, s, "/admin/login?token="+authAdminToken, false)
+			if second.Code != http.StatusForbidden {
+				t.Fatalf("replay status = %d, want 403; body:\n%s", second.Code, second.Body.String())
+			}
+			res := second.Result()
+			defer func() { _ = res.Body.Close() }()
+			if n := len(res.Cookies()); n != 0 {
+				t.Errorf("replay 403 set %d cookie(s), want 0", n)
+			}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestAdminLoginTokenEncodings pins the ADMIN_TOKEN encoding reconciliation:
+// config.Load stores the DECODED bytes of the base64-provisioned env value,
+// while the operator and the A-201 oracle submit the env value verbatim.
+// Both strings denote one secret, so both must exchange (and burn the same
+// one-time row).
+func TestAdminLoginTokenEncodings(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"base64 env-value form of the token is accepted", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			envForm := base64.StdEncoding.EncodeToString([]byte(authAdminToken))
+			rec := authGet(t, s, "/admin/login?token="+envForm, false)
+			if rec.Code != http.StatusFound {
+				t.Fatalf("status = %d, want 302; body:\n%s", rec.Code, rec.Body.String())
+			}
+			if loc := rec.Header().Get("Location"); loc != "/admin" {
+				t.Fatalf("Location = %q, want %q", loc, "/admin")
+			}
+			assertFrozenCookieFlags(t, sessionCookieOf(t, rec), config.EnvTest)
+		}},
+		{"either accepted encoding burns the same one-time row", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			envForm := base64.StdEncoding.EncodeToString([]byte(authAdminToken))
+			// First use via the env-value form.
+			first := authGet(t, s, "/admin/login?token="+envForm, false)
+			if first.Code != http.StatusFound {
+				t.Fatalf("env-form exchange status = %d, want 302", first.Code)
+			}
+			// The decoded form denotes the same consumed secret: refused.
+			decoded := authGet(t, s, "/admin/login?token="+authAdminToken, false)
+			if decoded.Code != http.StatusForbidden {
+				t.Fatalf("decoded-form after consume: status = %d, want 403", decoded.Code)
+			}
+			// The env-value replay: refused too.
+			replay := authGet(t, s, "/admin/login?token="+envForm, false)
+			if replay.Code != http.StatusForbidden {
+				t.Fatalf("env-form replay: status = %d, want 403", replay.Code)
+			}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestAdminLoginForm covers the form page and the CSRF-verified POST
+// variant of the exchange; case names are the assertions.
+func TestAdminLoginForm(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"no or blank token renders the frozen form", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			for _, target := range []string{"/admin/login", "/admin/login?token="} {
+				rec := authGet(t, s, target, false)
+				if rec.Code != http.StatusOK {
+					t.Errorf("GET %s: status = %d, want 200", target, rec.Code)
+				}
+				assertLoginMarkup(t, rec.Body.String())
+			}
+		}},
+		{"valid POST exchange with matching csrf", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			ct := mustCSRFToken(t)
+			form := url.Values{"token": {authAdminToken}, CSRFTokenName: {ct}}
+			rec := authPostForm(t, s, "/admin/login", ct, form)
+			if rec.Code != http.StatusFound {
+				t.Fatalf("status = %d, want 302; body:\n%s", rec.Code, rec.Body.String())
+			}
+			if loc := rec.Header().Get("Location"); loc != "/admin" {
+				t.Fatalf("Location = %q, want %q", loc, "/admin")
+			}
+			assertFrozenCookieFlags(t, sessionCookieOf(t, rec), config.EnvTest)
+		}},
+		{"POST with mismatched csrf 403", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			form := url.Values{"token": {authAdminToken}, CSRFTokenName: {mustCSRFToken(t)}}
+			rec := authPostForm(t, s, "/admin/login", mustCSRFToken(t), form)
+			if rec.Code != http.StatusForbidden {
+				t.Fatalf("status = %d, want 403; body:\n%s", rec.Code, rec.Body.String())
+			}
+		}},
+		{"POST without csrf 403", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			form := url.Values{"token": {authAdminToken}}
+			rec := authPostForm(t, s, "/admin/login", "", form)
+			if rec.Code != http.StatusForbidden {
+				t.Fatalf("status = %d, want 403; body:\n%s", rec.Code, rec.Body.String())
+			}
+		}},
+		{"POST blank token renders the form again", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			ct := mustCSRFToken(t)
+			form := url.Values{"token": {""}, CSRFTokenName: {ct}}
+			rec := authPostForm(t, s, "/admin/login", ct, form)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("status = %d, want 200 (the form page); body:\n%s", rec.Code, rec.Body.String())
+			}
+			assertLoginMarkup(t, rec.Body.String())
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
diff --git a/internal/web/session.go b/internal/web/session.go
new file mode 100644
index 0000000..b245f85
--- /dev/null
+++ b/internal/web/session.go
@@ -0,0 +1,135 @@
+package web
+
+// Admin session cookie and guard (A-201). auth.go exchanges the one-time
+// ADMIN_TOKEN for a session; this file owns the gl_session cookie format and
+// the AdminOnly wrapper that T-205 puts around every /admin route. The
+// cookie value is base64url(session id) + "." + hex(HMAC-SHA256(SessionKey,
+// id)): the HMAC makes the value unforgeable, so a cookie alone never
+// unlocks anything without its live sessions row.
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/amscotti/groveland-lights/internal/config"
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+// SessionCookieName is the admin session cookie, frozen by the A-201
+// contract ("gl_session").
+const SessionCookieName = "gl_session"
+
+// sessionCookieTTL is the cookie Max-Age and matches the store-side session
+// lifetime: the contract freezes Max-Age=86400 (24 h).
+const sessionCookieTTL = 24 * time.Hour
+
+// sessionValue encodes id for the cookie: base64url(id) + "." +
+// hex(HMAC-SHA256(key, id)).
+func sessionValue(key []byte, id string) string {
+	mac := hmac.New(sha256.New, key)
+	_, _ = mac.Write([]byte(id))
+	return base64.RawURLEncoding.EncodeToString([]byte(id)) + "." + hex.EncodeToString(mac.Sum(nil))
+}
+
+// sessionIDOf verifies a sessionValue-encoded cookie and returns the session
+// id it carries. Any structural defect or signature mismatch (compared
+// constant-time) yields ok=false.
+func sessionIDOf(key []byte, value string) (id string, ok bool) {
+	encoded, sig, found := strings.Cut(value, ".")
+	if !found {
+		return "", false
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil || len(raw) == 0 {
+		return "", false
+	}
+	id = string(raw)
+	mac := hmac.New(sha256.New, key)
+	_, _ = mac.Write([]byte(id))
+	if subtle.ConstantTimeCompare([]byte(sig), []byte(hex.EncodeToString(mac.Sum(nil)))) != 1 {
+		return "", false
+	}
+	return id, true
+}
+
+// setSessionCookie sets the admin session cookie for id on the response:
+// Path=/, HttpOnly, SameSite=Lax, Max-Age 86400, Secure exactly in prod
+// (frozen attribute set; the A-201 draft parses and compares them exactly).
+func setSessionCookie(cfg config.Config, w http.ResponseWriter, id string) {
+	http.SetCookie(w, &http.Cookie{ //nolint:gosec // Secure comes from cfg.IsProd(); dev/test intentionally serve without TLS (same door as csrf.go)
+		Name:     SessionCookieName,
+		Value:    sessionValue(cfg.SessionKey, id),
+		Path:     "/",
+		MaxAge:   int(sessionCookieTTL.Seconds()),
+		HttpOnly: true,
+		SameSite: http.SameSiteLaxMode,
+		Secure:   cfg.IsProd(),
+	})
+}
+
+// AdminOnly guards an admin handler: a request carrying a cookie that
+// verifies against a live, unexpired, admin-role session passes through;
+// everyone else is bounced to the login page — a 302 for full-page
+// navigations, 401 with HX-Redirect: /admin/login and an empty body for
+// HTMX fragment requests (frozen contract A-201). T-205 wraps every /admin
+// route with this.
+func AdminOnly(next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		s := serverFrom(r.Context())
+		if !s.validAdminSession(r) {
+			if r.Header.Get("HX-Request") != "" {
+				w.Header().Set("HX-Redirect", "/admin/login")
+				w.WriteHeader(http.StatusUnauthorized)
+				return
+			}
+			http.Redirect(w, r, "/admin/login", http.StatusFound)
+			return
+		}
+		next(w, r)
+	}
+}
+
+// validAdminSession verifies the gl_session cookie end to end: structure and
+// signature, live store row, expiry and admin role. Any failure refuses; the
+// reason goes to the log, never to the response — and neither the token nor
+// any credential value is ever logged.
+func (s *Server) validAdminSession(r *http.Request) bool {
+	c, err := r.Cookie(SessionCookieName)
+	if err != nil || c.Value == "" {
+		return false
+	}
+	id, ok := sessionIDOf(s.Cfg.SessionKey, c.Value)
+	if !ok {
+		s.Log.Info("admin session: cookie signature rejected")
+		return false
+	}
+	if s.Store == nil {
+		s.Log.Error("admin session: store not wired")
+		return false
+	}
+	_, role, valid, err := s.Store.SessionValid(r.Context(), id)
+	if err != nil {
+		if errors.Is(err, store.ErrBadCredentials) {
+			// Expired: best-effort cleanup of the stale row so expired
+			// sessions do not accumulate, then the ordinary refusal path.
+			if derr := s.Store.DeleteSession(r.Context(), id); derr != nil {
+				s.Log.Error("admin session: expire cleanup", "err", derr)
+			}
+			s.Log.Info("admin session: expired session refused")
+			return false
+		}
+		s.Log.Error("admin session: lookup failed", "err", err)
+		return false // fail closed
+	}
+	if !valid {
+		return false
+	}
+	return role == "admin"
+}
diff --git a/internal/web/session_test.go b/internal/web/session_test.go
new file mode 100644
index 0000000..0776fc1
--- /dev/null
+++ b/internal/web/session_test.go
@@ -0,0 +1,214 @@
+package web
+
+import (
+	"context"
+	"encoding/base64"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/amscotti/groveland-lights/internal/config"
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+// guardedStub is the handler AdminOnly protects in these tests; it writes a
+// marker body so every case can tell "passed through" from "refused".
+func guardedStub(w http.ResponseWriter, r *http.Request) {
+	_, _ = w.Write([]byte("admin-ok"))
+}
+
+// guardedGet builds a GET /admin request carrying the given cookie value
+// ("" = no cookie) and optionally the HTMX header, then runs the guard.
+func guardedGet(s *Server, cookieValue string, hx bool) *httptest.ResponseRecorder {
+	req := httptest.NewRequestWithContext(context.Background(), http.MethodGet, "/admin", nil)
+	if cookieValue != "" {
+		req.AddCookie(&http.Cookie{Name: SessionCookieName, Value: cookieValue})
+	}
+	if hx {
+		req.Header.Set("HX-Request", "true")
+	}
+	rec := httptest.NewRecorder()
+	AdminOnly(guardedStub)(rec, req.WithContext(context.WithValue(req.Context(), ctxServer, s)))
+	return rec
+}
+
+// adminCookie exchanges the test ADMIN_TOKEN through the full chain and
+// returns the minted gl_session cookie (and the session id it carries).
+func adminCookie(t *testing.T, s *Server) (*http.Cookie, string) {
+	t.Helper()
+	rec := authGet(t, s, "/admin/login?token="+authAdminToken, false)
+	if rec.Code != http.StatusFound {
+		t.Fatalf("token exchange status = %d, want 302; body:\n%s", rec.Code, rec.Body.String())
+	}
+	c := sessionCookieOf(t, rec)
+	id, ok := sessionIDOf(authSessionKey, c.Value)
+	if !ok {
+		t.Fatalf("minted cookie value %q does not verify", c.Value)
+	}
+	return c, id
+}
+
+// TestAdminOnlyGuard covers the guard as a table of flows; case names are
+// the assertions.
+func TestAdminOnlyGuard(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"anon full page redirected to login", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			assertRedirectToLogin(t, guardedGet(s, "", false))
+		}},
+		{"anon HTMX gets 401 plus HX-Redirect", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			rec := guardedGet(s, "", true)
+			if rec.Code != http.StatusUnauthorized {
+				t.Fatalf("status = %d, want 401; body:\n%s", rec.Code, rec.Body.String())
+			}
+			if loc := rec.Header().Get("HX-Redirect"); loc != "/admin/login" {
+				t.Fatalf("HX-Redirect = %q, want %q", loc, "/admin/login")
+			}
+			if rec.Body.Len() != 0 {
+				t.Fatalf("401 body = %q, want empty", rec.Body.String())
+			}
+			if strings.Contains(rec.Body.String(), "admin-ok") {
+				t.Fatal("guarded handler ran despite the refusal")
+			}
+		}},
+		{"admin cookie passes AdminOnly", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			c, _ := adminCookie(t, s)
+			rec := guardedGet(s, c.Value, false)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("status = %d, want 200; body:\n%s", rec.Code, rec.Body.String())
+			}
+			if rec.Body.String() != "admin-ok" {
+				t.Fatalf("guarded handler did not run; body = %q", rec.Body.String())
+			}
+		}},
+		{"admin HTMX with a valid cookie passes too", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			c, _ := adminCookie(t, s)
+			rec := guardedGet(s, c.Value, true)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("status = %d, want 200; body:\n%s", rec.Code, rec.Body.String())
+			}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestAdminOnlyGuardRefusals covers every rejection path of the guard; case
+// names are the assertions.
+func TestAdminOnlyGuardRefusals(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"tampered cookie signature rejected", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			c, _ := adminCookie(t, s)
+			tampered := c.Value[:len(c.Value)-1]
+			if c.Value[len(c.Value)-1] == 'a' {
+				tampered += "b"
+			} else {
+				tampered += "a"
+			}
+			assertRedirectToLogin(t, guardedGet(s, tampered, false))
+		}},
+		{"expired session rejected (injected clock)", func(t *testing.T) {
+			s, db := newAuthServer(t, config.EnvTest)
+			c, id := adminCookie(t, s)
+			// Push the auth slice's clock past the session's 24 h lifetime;
+			// restored on cleanup so no other test sees a shifted clock.
+			prev := store.Now
+			store.Now = func() time.Time { return prev().Add(25 * time.Hour) }
+			t.Cleanup(func() { store.Now = prev })
+
+			assertRedirectToLogin(t, guardedGet(s, c.Value, false))
+			// The expired row was swept: no row answers for the id any more
+			// (missing sessions carry a nil error, unlike expired ones).
+			_, _, ok, err := db.SessionValid(context.Background(), id)
+			if ok || err != nil {
+				t.Fatalf("expired session row survived: ok=%v err=%v", ok, err)
+			}
+		}},
+		{"user-role session rejected", func(t *testing.T) {
+			s, db := newAuthServer(t, config.EnvTest)
+			ctx := context.Background()
+			uid, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser: %v", err)
+			}
+			sid, err := db.CreateSession(ctx, uid, "user")
+			if err != nil {
+				t.Fatalf("CreateSession: %v", err)
+			}
+			assertRedirectToLogin(t, guardedGet(s, sessionValue(authSessionKey, sid), false))
+		}},
+		{"cookie signed with another key rejected", func(t *testing.T) {
+			s, db := newAuthServer(t, config.EnvTest)
+			ctx := context.Background()
+			uid, err := db.EnsureAdminUser(ctx)
+			if err != nil {
+				t.Fatalf("EnsureAdminUser: %v", err)
+			}
+			sid, err := db.CreateSession(ctx, uid, "admin")
+			if err != nil {
+				t.Fatalf("CreateSession: %v", err)
+			}
+			otherKey := []byte("99999999999999999999999999999999")
+			assertRedirectToLogin(t, guardedGet(s, sessionValue(otherKey, sid), false))
+		}},
+		{"structurally invalid cookie rejected", func(t *testing.T) {
+			s, _ := newAuthServer(t, config.EnvTest)
+			assertRedirectToLogin(t, guardedGet(s, "garbage", false))
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+// TestSessionValueRoundTrip pins the cookie codec directly: the exact
+// structure the guard parses.
+func TestSessionValueRoundTrip(t *testing.T) {
+	id := "MgisOMh2YRG2S9YRShtazoR-Ci1Q8WfJmmvKlj7C_5g"
+	value := sessionValue(authSessionKey, id)
+	encoded, sig, found := strings.Cut(value, ".")
+	// The frozen format is base64url(id) + "." + hex(HMAC-SHA256(key, id)):
+	// the id is encoded AGAIN for the cookie, and the codec must invert it.
+	if !found || encoded != base64.RawURLEncoding.EncodeToString([]byte(id)) {
+		t.Fatalf("sessionValue = %q, want <base64url(id)>.<signature>", value)
+	}
+	if len(sig) != 64 {
+		t.Fatalf("signature = %q (%d chars), want 64 hex chars", sig, len(sig))
+	}
+	got, ok := sessionIDOf(authSessionKey, value)
+	if !ok || got != id {
+		t.Fatalf("sessionIDOf = (%q, %v), want (%q, true)", got, ok, id)
+	}
+
+	tests := []struct {
+		name  string
+		value string
+	}{
+		{"missing dot rejected", id},
+		{"undecodable id part rejected", "###.deadbeef"},
+		{"empty id part rejected", ".deadbeef"},
+		{"wrong signature rejected", id + ".00000000000000000000000000000000"},
+		{"signature part missing rejected", id + "."},
+		{"empty value rejected", ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got, ok := sessionIDOf(authSessionKey, tc.value); ok {
+				t.Fatalf("sessionIDOf accepted %q as %q", tc.value, got)
+			}
+		})
+	}
+}
