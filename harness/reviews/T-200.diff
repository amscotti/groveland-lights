+// --- al helpers (self-contained on purpose: activation is a pure rename,
+// so this file must not depend on helpers defined elsewhere in the package) ---
+
+// alLogin exchanges the one-time ADMIN_TOKEN for a session cookie and parses
+// the CSRF token from the walk page's add-light form.
+func alLogin(t *testing.T, s *alServer) (*http.Client, string) {
+	t.Helper()
+	c := alClient(t)
+	status, _, _ := alDo(t, c, http.MethodGet, s.baseURL+"/admin/login?token="+alAdminToken, nil, false)
+	if status != http.StatusFound {
+		t.Fatalf("admin login: status %d, want 302 (token exchange failed)", status)
+	}
+	return c, alCSRF(t, c, s.baseURL)
+}
+
+// alCSRF fetches the walk page and extracts the add-light form's csrf_token.
+func alCSRF(t *testing.T, c *http.Client, base string) string {
+	t.Helper()
+	status, _, body := alDo(t, c, http.MethodGet, base+"/admin/walk", nil, false)
+	if status != http.StatusOK {
+		t.Fatalf("GET /admin/walk: status %d, want 200; body:\n%s", status, body)
+	}
+	input := alReCSRF.FindString(body)
+	if input == "" {
+		t.Fatalf("GET /admin/walk: no hidden input named csrf_token; body:\n%s", body)
+	}
+	v := alReValue.FindStringSubmatch(input)
+	if v == nil {
+		t.Fatalf("GET /admin/walk: csrf_token input has no value; body:\n%s", body)
+	}
+	return v[1]
+}
+
+// alCreate POSTs the add-light form (multipart) without HX-Request.
+func alCreate(t *testing.T, c *http.Client, base string, fields map[string]string, photoName string, photoData []byte) (int, http.Header, string) {
+	t.Helper()
+	return alPostMultipart(t, c, base+"/admin/lights", fields, "photo", photoName, photoData, false)
+}
+
+// alPostMultipart builds one multipart/form-data request. fileField=""
+// means no file part.
+func alPostMultipart(t *testing.T, c *http.Client, target string, fields map[string]string, fileField, fileName string, fileData []byte, hx bool) (int, http.Header, string) {
+	t.Helper()
+	var buf bytes.Buffer
+	w := multipart.NewWriter(&buf)
+	for k, v := range fields {
+		if err := w.WriteField(k, v); err != nil {
+			t.Fatalf("multipart field %s: %v", k, err)
+		}
+	}
+	if fileField != "" {
+		fw, err := w.CreateFormFile(fileField, fileName)
+		if err != nil {
+			t.Fatalf("multipart file %s: %v", fileName, err)
+		}
+		if _, err := fw.Write(fileData); err != nil {
+			t.Fatalf("multipart write %s: %v", fileName, err)
+		}
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("multipart close: %v", err)
+	}
+	req, err := http.NewRequest(http.MethodPost, target, &buf)
+	if err != nil {
+		t.Fatalf("POST %s: %v", target, err)
+	}
+	req.Header.Set("Content-Type", w.FormDataContentType())
+	if hx {
+		req.Header.Set("HX-Request", "true")
+	}
+	resp, err := c.Do(req)
+	if err != nil {
+		t.Fatalf("POST %s: %v", target, err)
+	}
+	defer resp.Body.Close()
+	b, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatalf("POST %s: read body: %v", target, err)
+	}
+	return resp.StatusCode, resp.Header, string(b)
+}
+
+// alDo performs one request, optionally with HX-Request: true.
+func alDo(t *testing.T, c *http.Client, method, target string, body io.Reader, hx bool) (int, http.Header, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, target, body)
+	if err != nil {
+		t.Fatalf("%s %s: %v", method, target, err)
+	}
+	if hx {
+		req.Header.Set("HX-Request", "true")
+	}
+	resp, err := c.Do(req)
+	if err != nil {
+		t.Fatalf("%s %s: %v", method, target, err)
+	}
+	defer resp.Body.Close()
+	b, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatalf("%s %s: read body: %v", method, target, err)
+	}
+	return resp.StatusCode, resp.Header, string(b)
+}
+
+// alGet fetches a page and requires 200.
+func alGet(t *testing.T, c *http.Client, target string) string {
+	t.Helper()
+	status, _, body := alDo(t, c, http.MethodGet, target, nil, false)
+	if status != http.StatusOK {
+		t.Fatalf("GET %s: status %d, want 200; body:\n%s", target, status, body)
+	}
+	return body
+}
+
+// alGetPhoto fetches a binary URL and requires 200, returning headers and
+// the raw bytes.
+func alGetPhoto(t *testing.T, c *http.Client, target string) (http.Header, []byte) {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodGet, target, nil)
+	if err != nil {
+		t.Fatalf("GET %s: %v", target, err)
+	}
+	resp, err := c.Do(req)
+	if err != nil {
+		t.Fatalf("GET %s: %v", target, err)
+	}
+	defer resp.Body.Close()
+	b, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatalf("GET %s: read body: %v", target, err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("GET %s: status %d, want 200", target, resp.StatusCode)
+	}
+	return resp.Header, b
+}
+
+// alFixture walks up from the working directory to the repo root and reads
+// testdata/photos/<name>.
+func alFixture(t *testing.T, name string) []byte {
+	t.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("getwd: %v", err)
+	}
+	for i := 0; i < 8; i++ {
+		cand := filepath.Join(dir, "testdata", "photos", name)
+		if b, err := os.ReadFile(cand); err == nil {
+			return b
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+	}
+	t.Fatalf("fixture testdata/photos/%s not found (run from the repo root)", name)
+	return nil
+}
+
+// alOversizeJPEG pads a valid fixture JPEG (after its EOI marker) past the
+// 15 MB upload cap; total is at least want bytes.
+func alOversizeJPEG(t *testing.T, fixture string, want int) []byte {
+	t.Helper()
+	base := alFixture(t, fixture)
+	if len(base) >= want {
+		t.Fatalf("fixture %s is already %d bytes; pick a larger target", fixture, len(base))
+	}
+	out := make([]byte, 0, want)
+	out = append(out, base...)
+	out = append(out, bytes.Repeat([]byte{0x55}, want-len(base))...)
+	return out
+}
+
+// alCountFiles counts regular files under dir (0 when it does not exist).
+func alCountFiles(t *testing.T, dir string) int {
+	t.Helper()
+	names := alListFiles(t, dir)
+	return len(names)
+}
+
+// alListFiles lists regular files under dir, sorted (0-entry slice when the
+// directory does not exist yet).
+func alListFiles(t *testing.T, dir string) []string {
+	t.Helper()
+	var names []string
+	err := filepath.WalkDir(dir, func(p string, d os.DirEntry, err error) error {
+		if err != nil {
+			if os.IsNotExist(err) {
+				return nil
+			}
+			return err
+		}
+		if !d.IsDir() {
+			names = append(names, p)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("walk %s: %v", dir, err)
+	}
+	return names
+}
+
+// alFindApp1 returns the first APP1 segment payload, if any.
+func alFindApp1(data []byte) ([]byte, bool) {
+	i, _, next, ok := alWalkToMarker(data, 2, 0xe1)
+	if !ok {
+		return nil, false
+	}
+	return data[i+4 : next], true
+}
+
+// alHasExifGps reports whether the JPEG bytes carry an EXIF APP1 segment
+// whose GPSInfo pointer (tag 0x8825) resolves to a non-empty IFD.
+func alHasExifGps(data []byte) bool {
+	i, _, next, ok := alWalkToMarker(data, 2, 0xe1)
+	if !ok {
+		return false
+	}
+	seg := data[i+4 : next]
+	if len(seg) < 6 || string(seg[:6]) != "Exif\x00\x00" {
+		return false
+	}
+	return alTiffHasGps(seg[6:])
+}
+
+// alTiffHasGps parses a TIFF header (either endianness) and reports whether
+// IFD0 holds a GPSInfo pointer to a non-empty IFD.
+func alTiffHasGps(tiff []byte) bool {
+	if len(tiff) < 8 {
+		return false
+	}
+	var le bool
+	switch {
+	case bytes.Equal(tiff[:2], []byte("II")):
+		le = true
+	case bytes.Equal(tiff[:2], []byte("MM")):
+		le = false
+	default:
+		return false
+	}
+	u16 := func(o int) int {
+		if le {
+			return int(binary.LittleEndian.Uint16(tiff[o : o+2]))
+		}
+		return int(binary.BigEndian.Uint16(tiff[o : o+2]))
+	}
+	u32 := func(o int) int {
+		if le {
+			return int(binary.LittleEndian.Uint32(tiff[o : o+4]))
+		}
+		return int(binary.BigEndian.Uint32(tiff[o : o+4]))
+	}
+	ifd0 := u32(4)
+	if ifd0+2 > len(tiff) {
+		return false
+	}
+	for e := 0; e < u16(ifd0); e++ {
+		base := ifd0 + 2 + e*12
+		if base+12 > len(tiff) {
+			return false
+		}
+		if u16(base) == 0x8825 {
+			gps := u32(base + 8)
+			return gps+2 <= len(tiff) && u16(gps) > 0
+		}
+	}
+	return false
+}
+
+// alJpegDims parses the frame dimensions from the first SOF marker
+// (baseline or progressive).
+func alJpegDims(data []byte) (int, int, error) {
+	i := 2
+	for i+4 <= len(data) {
+		if data[i] != 0xff {
+			return 0, 0, errors.New("jpeg dims: lost marker synchronisation")
+		}
+		marker := int(data[i+1])
+		switch {
+		case marker == 0x01 || (marker >= 0xd0 && marker <= 0xd7):
+			i += 2
+			continue
+		case marker == 0xd9 || marker == 0xda:
+			return 0, 0, errors.New("jpeg dims: no SOF marker before the scan data")
+		}
+		segLen := int(binary.BigEndian.Uint16(data[i+2 : i+4]))
+		next := i + 2 + segLen
+		if segLen < 2 || next > len(data) {
+			return 0, 0, errors.New("jpeg dims: malformed segment length")
+		}
+		if marker >= 0xc0 && marker <= 0xcf && marker != 0xc4 && marker != 0xc8 && marker != 0xcc {
+			if next < i+9 {
+				return 0, 0, errors.New("jpeg dims: truncated SOF segment")
+			}
+			h := int(binary.BigEndian.Uint16(data[i+5 : i+7]))
+			w := int(binary.BigEndian.Uint16(data[i+7 : i+9]))
+			return w, h, nil
+		}
+		i = next
+	}
+	return 0, 0, errors.New("jpeg dims: no SOF marker found")
+}
+
+// alWalkToMarker scans JPEG segments from offset start until it finds the
+// requested marker; it returns the marker offset, the marker, the offset one
+// past the segment and whether the marker was found.
+func alWalkToMarker(data []byte, start int, want byte) (int, byte, int, bool) {
+	i := start
+	for i+4 <= len(data) {
+		if data[i] != 0xff {
+			return 0, 0, 0, false
+		}
+		marker := data[i+1]
+		if marker == 0x01 || (marker >= 0xd0 && marker <= 0xd7) {
+			i += 2
+			continue
+		}
+		if marker == 0xd9 || marker == 0xda {
+			return 0, 0, 0, false // metadata only precedes the scan
+		}
+		segLen := int(binary.BigEndian.Uint16(data[i+2 : i+4]))
+		next := i + 2 + segLen
+		if segLen < 2 || next > len(data) {
+			return 0, 0, 0, false
+		}
+		if marker == want {
+			return i, marker, next, true
+		}
+		i = next
+	}
+	return 0, 0, 0, false
+}
+
+// alClient is a cookie-carrying client that never follows redirects (so the
+// 303s of the no-JS flows stay observable).
+func alClient(t *testing.T) *http.Client {
+	t.Helper()
+	jar, err := cookiejar.New(nil)
+	if err != nil {
+		t.Fatalf("cookie jar: %v", err)
+	}
+	return &http.Client{
+		Jar:     jar,
+		Timeout: 30 * time.Second,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+}
+
+type alSyncBuf struct {
+	mu  sync.Mutex
+	buf strings.Builder
+}
+
+func (b *alSyncBuf) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+func (b *alSyncBuf) String() string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.String()
+}
+
+// alServer is one spawned instance.
+type alServer struct {
+	cmd      *exec.Cmd
+	baseURL  string
+	dbPath   string
+	photoDir string
+	out      *alSyncBuf
+	stopped  bool
+}
+
+// alSpawnDir starts the server (APP_ENV=test) on its own free port with the
+// dummy .env.test secrets; empty dbPath/photoDir mean fresh paths under a
+// t.TempDir().
+func alSpawnDir(t *testing.T, dbPath, photoDir string) *alServer {
+	t.Helper()
+	bin := alFindBin(t)
+	dir := t.TempDir()
+	if dbPath == "" {
+		dbPath = filepath.Join(dir, "app.db")
+	}
+	if photoDir == "" {
+		photoDir = filepath.Join(dir, "photos")
+	}
+	port := alFreePort(t)
+	base := "http://127.0.0.1:" + strconv.Itoa(port)
+	out := &alSyncBuf{}
+	cmd := exec.Command(bin)
+	cmd.Dir = dir
+	cmd.Env = []string{
+		"PORT=" + strconv.Itoa(port),
+		"APP_ENV=test",
+		"BASE_URL=" + base,
+		"DB_PATH=" + dbPath,
+		"PHOTO_DIR=" + photoDir,
+		"SESSION_KEY=dGVzdC1zZXNzaW9uLWtleS0zMi1ieXRlcy1hYQ==",
+		"IP_HASH_KEY=dGVzdC1pcGhhc2gta2V5LTMyLWJ5dGVzLWJi",
+		"ADMIN_TOKEN=" + alAdminToken,
+		"TOWN_BBOX=42.70,-71.09,42.82,-70.96",
+		"TZ=America/New_York",
+		"PATH=" + os.Getenv("PATH"),
+	}
+	cmd.Stdout, cmd.Stderr = out, out
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("start %s: %v", bin, err)
+	}
+	s := &alServer{cmd: cmd, baseURL: base, dbPath: dbPath, photoDir: photoDir, out: out}
+	alWaitHealthy(t, s, 5*time.Second)
+	return s
+}
+
+// alKill is the cleanup stop (SIGKILL + wait), idempotent.
+func alKill(t *testing.T, s *alServer) {
+	t.Helper()
+	if s.stopped {
+		return
+	}
+	s.stopped = true
+	_ = s.cmd.Process.Kill()
+	_ = s.cmd.Wait()
+}
+
+// alFindBin resolves the server binary: $BIN, else bin/server walked up from
+// the test working directory to the repo root.
+func alFindBin(t *testing.T) string {
+	t.Helper()
+	if p := os.Getenv("BIN"); p != "" {
+		abs, err := filepath.Abs(p)
+		if err != nil {
+			t.Fatalf("BIN=%q: %v", p, err)
+		}
+		if _, err := os.Stat(abs); err != nil {
+			t.Fatalf("BIN=%q: %v", p, err)
+		}
+		return abs
+	}
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("getwd: %v", err)
+	}
+	for i := 0; i < 8; i++ {
+		cand := filepath.Join(dir, "bin", "server")
+		if st, err := os.Stat(cand); err == nil && !st.IsDir() && st.Mode()&0o111 != 0 {
+			return cand
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+	}
+	t.Fatal("server binary not found: run `make build` or set BIN")
+	return ""
+}
+
+// alFreePort picks a free TCP port by listening on 127.0.0.1:0 and closing.
+func alFreePort(t *testing.T) int {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen :0: %v", err)
+	}
+	defer l.Close()
+	return l.Addr().(*net.TCPAddr).Port
+}
+
+// alWaitHealthy polls /healthz until 200 with a context deadline; a hung or
+// crashed server fails the test with its output instead of hanging.
+func alWaitHealthy(t *testing.T, s *alServer, timeout time.Duration) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	client := &http.Client{Timeout: 1 * time.Second}
+	for {
+		req, err := http.NewRequestWithContext(ctx, http.MethodGet, s.baseURL+"/healthz", nil)
+		if err != nil {
+			t.Fatalf("new request: %v", err)
+		}
+		if resp, err := client.Do(req); err == nil {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			_ = resp.Body.Close()
+			if resp.StatusCode == http.StatusOK {
+				return
+			}
+		}
+		select {
+		case <-ctx.Done():
+			alKill(t, s)
+			t.Fatalf("server not healthy within %s; output:\n%s", timeout, s.out.String())
+		case <-time.After(50 * time.Millisecond):
+		}
+	}
+}
diff --git a/acceptance/e2e/util/admin.ts b/acceptance/e2e/util/admin.ts
new file mode 100644
index 0000000..8fa3327
--- /dev/null
+++ b/acceptance/e2e/util/admin.ts
@@ -0,0 +1,197 @@
+import { request, type Page } from '@playwright/test';
+import { readFileSync, rmSync, writeFileSync } from 'node:fs';
+
+/**
+ * Admin login helper for the M2 drafts (A-201). ACTIVE util (no tests of its
+ * own).
+ *
+ * Contract shape (T-203): ADMIN_TOKEN exchanges for an admin session via
+ * GET /admin/login?token=..., the token is one-time GLOBALLY (the login_tokens
+ * row's used_at is DB state — a replay answers 403 from any client), and the
+ * minted gl_session cookie is valid for 24 h. Playwright gives every test a
+ * FRESH context (fresh cookie jar) while the webServer shares one persistent
+ * ./test-run.db across the whole run AND across the e2e → a11y invocations of
+ * `make check` — so a naive "visit the token URL per test" login burns the
+ * one-time token on the first test and 403s every login after it.
+ *
+ * This helper exchanges the token AT MOST ONCE per test-run.db lifetime and
+ * reuses the session everywhere:
+ *
+ *   1. an in-process memo (one exchange per Playwright invocation), then
+ *   2. a cookie cache file next to the DB (test-run.db.session.json — the
+ *      .gitignore pattern `test-run.db*` covers it, so it lives and dies
+ *      with the DB it belongs to and lets `make check`'s second Playwright
+ *      invocation (a11y) reuse the e2e invocation's session), and
+ *   3. a validation GET /admin before adoption — a dead session (expired,
+ *      or the DB was recreated) is detected without consuming anything and
+ *      falls through to a fresh exchange.
+ *
+ * When the token is already consumed AND no valid session can be recovered
+ * (e.g. test-run.db outlived the 24 h session TTL), the helper fails with
+ * the operator fix: `rm -f test-run.db*` and rerun.
+ */
+
+const DEFAULT_ADMIN_TOKEN = 'dGVzdC1hZG1pbi10b2tlbi0zMi1ieXRl';
+const SESSION_COOKIE = 'gl_session';
+/** Mirrors playwright.config.ts (the port MUST match in every process). */
+const ORIGIN =
+  process.env.BASE_URL ?? `http://127.0.0.1:${Number(process.env.TEST_PORT ?? 8931)}`;
+/** Cache path shares the DB's gitignore pattern (test-run.db*) and lifetime. */
+const CACHE_PATH = 'test-run.db.session.json';
+
+interface SessionCache {
+  origin: string;
+  cookie: string;
+  savedAt: number;
+}
+
+let memo: SessionCache | null = null;
+let inFlight: Promise<SessionCache> | null = null;
+
+/**
+ * loginAsAdmin leaves `page` on an authenticated /admin. Safe to call from
+ * every test on every project: no token is consumed when a reusable session
+ * exists.
+ */
+export async function loginAsAdmin(page: Page): Promise<void> {
+  await injectSessionCookie(page, await currentSession());
+  await page.goto('/admin');
+  if (!page.url().endsWith('/admin/login')) {
+    return;
+  }
+  // The adopted session died between validation and use (DB swapped under
+  // us, or the 24 h TTL expired mid-run). Invalidate and try exactly once
+  // more with a forced re-validation.
+  memo = null;
+  clearCache();
+  await injectSessionCookie(page, await currentSession());
+  await page.goto('/admin');
+  if (page.url().endsWith('/admin/login')) {
+    throw new Error(
+      'loginAsAdmin: no valid admin session and the token exchange did not ' +
+        'mint one. If ADMIN_TOKEN was already consumed in this server\'s DB ' +
+        '(one-time, A-201), remove the runtime DB and cache ' +
+        `(rm -f ${CACHE_PATH} test-run.db*) and rerun.`,
+    );
+  }
+}
+
+/** Returns a session proven valid for this origin, exchanging at most once. */
+async function currentSession(): Promise<SessionCache> {
+  if (inFlight) {
+    return inFlight;
+  }
+  inFlight = (async () => {
+    const candidates = [memo, readCache()];
+    for (const candidate of candidates) {
+      if (candidate && candidate.origin === ORIGIN && (await sessionWorks(candidate))) {
+        memo = candidate;
+        return candidate;
+      }
+    }
+    memo = await exchangeToken();
+    writeCache(memo);
+    return memo;
+  })().finally(() => {
+    inFlight = null;
+  });
+  return inFlight;
+}
+
+/** A session works when /admin accepts it instead of bouncing to the login. */
+async function sessionWorks(session: SessionCache): Promise<boolean> {
+  const api = await request.newContext({
+    baseURL: ORIGIN,
+    extraHTTPHeaders: { Cookie: `${SESSION_COOKIE}=${session.cookie}` },
+  });
+  try {
+    const res = await api.get('/admin', { maxRedirects: 0 });
+    return (
+      res.status() === 200 &&
+      !(res.headers()['location'] ?? '').includes('/admin/login')
+    );
+  } catch {
+    return false;
+  } finally {
+    await api.dispose();
+  }
+}
+
+/**
+ * The one-time exchange: GET /admin/login?token=... must answer 302 to /admin
+ * with a gl_session Set-Cookie (A-201). Called at most once per DB lifetime.
+ */
+async function exchangeToken(): Promise<SessionCache> {
+  const token = process.env.ADMIN_TOKEN ?? DEFAULT_ADMIN_TOKEN;
+  const api = await request.newContext({ baseURL: ORIGIN });
+  try {
+    const res = await api.get(`/admin/login?token=${encodeURIComponent(token)}`, {
+      maxRedirects: 0,
+    });
+    const setCookie = res.headers()['set-cookie'] ?? '';
+    const match = setCookie.match(new RegExp(`${SESSION_COOKIE}=([^;]+)`));
+    if (res.status() !== 302 || !match) {
+      throw new Error(
+        `loginAsAdmin: token exchange failed (status ${res.status()}). ` +
+          'Either ADMIN_TOKEN is wrong for this server, or the token was ' +
+          'already consumed (one-time, A-201). Remove the runtime DB and ' +
+          `cache (rm -f ${CACHE_PATH} test-run.db*) and rerun.`,
+      );
+    }
+    return { origin: ORIGIN, cookie: match[1], savedAt: Date.now() };
+  } finally {
+    await api.dispose();
+  }
+}
+
+async function injectSessionCookie(page: Page, session: SessionCache): Promise<void> {
+  await page.context().addCookies([
+    {
+      name: SESSION_COOKIE,
+      value: session.cookie,
+      url: ORIGIN,
+      httpOnly: true,
+      sameSite: 'Lax',
+    },
+  ]);
+}
+
+function readCache(): SessionCache | null {
+  try {
+    const parsed = JSON.parse(readFileSync(CACHE_PATH, 'utf8')) as SessionCache;
+    return typeof parsed.cookie === 'string' && parsed.cookie !== ''
+      ? parsed
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+function writeCache(session: SessionCache): void {
+  try {
+    writeFileSync(CACHE_PATH, JSON.stringify(session), { mode: 0o600 });
+  } catch (err) {
+    // NOT a harmless degradation: ADMIN_TOKEN is one-time GLOBAL, so the
+    // next Playwright invocation sharing this DB (make check: e2e then
+    // a11y) cannot re-exchange and will fail its login. The invocation at
+    // hand still succeeds via the in-process memo; make check therefore
+    // REQUIRES a writable cache path (the repo root, next to test-run.db).
+    // Surface the reason on stderr instead of failing the passing run.
+    process.stderr.write(
+      `loginAsAdmin: cannot write ${CACHE_PATH} ` +
+        `(${err instanceof Error ? err.message : String(err)}). The current run ` +
+        'succeeds via its in-process session, but the next invocation against ' +
+        'this DB (make check: a11y after e2e) will find no cached session and ' +
+        'the one-time token is already consumed. Fix the write or remove ' +
+        'test-run.db* for a clean cycle.\n',
+    );
+  }
+}
+
+function clearCache(): void {
+  try {
+    rmSync(CACHE_PATH);
+  } catch {
+    // Best effort only; see writeCache.
+  }
+}
