+// M2 acceptance drafts (T-200): A-201..A-209 for the admin "walk the town"
+// flow, written as a frozen UI contract BEFORE any feature exists.
+//
+// INERT DRAFT: the `.spec.ts.txt` extension means no runner loads this file.
+// T-207 activates it verbatim, with a rename only and NO content edits:
+//
+//   git mv acceptance/drafts/admin-walk.spec.ts.txt acceptance/e2e/admin-walk.spec.ts
+//
+// It FAILS against current main by design (no /admin routes; every test
+// times out on its first admin-page assertion).
+//
+// The frozen UI contract (element names, exact button/label strings, routes,
+// response codes) lives in acceptance/drafts/README.md — workers build to
+// that table EXACTLY. Two ACTIVE utils are imported: ./util/admin.js
+// (loginAsAdmin — exchanges the ONE-TIME admin token at most once per
+// test-run.db lifetime and reuses the 24 h session cookie; see the util's
+// header for why a per-test token visit can never work) and
+// ./util/images.js (hasAPP1, hasExifGps, jpegSize).
+//
+// RERUN SAFETY (frozen; T-207 must not need to touch this): one webServer
+// with a persistent ./test-run.db serves ALL tests on ALL four projects, and
+// `make check` runs a second Playwright invocation (a11y) against the same
+// DB. The drafts therefore never rely on a fixed database state:
+//
+//   - every created light carries an asset number unique per run, per
+//     project AND per test (`GP-017-<run>-<proj>-<tag>`; the packet's
+//     GP-017/GP-018 prefixes are kept so `img[alt^="GP-017"]` still
+//     matches, and the value still satisfies the frozen
+//     `^[A-Za-z0-9-]{1,32}$` asset_no rule) — a failing test can never
+//     poison a later test's asset number;
+//   - every UNNUMBERED create (the 8 m duplicate radius makes coordinates a
+//     de-facto key) uses coordinates jittered deterministically per run and
+//     per test, always inside TOWN_BBOX;
+//   - each test first deletes any same-labelled leftovers (soft delete
+//     frees both the asset number and the coordinates for the partial
+//     unique index / duplicate checks) and deletes what it created at the
+//     end, so a passing suite leaves an empty list behind;
+//   - POSTs via page.request pin `maxRedirects: 0` so the frozen 303s stay
+//     observable (Playwright's API request context follows redirects by
+//     default);
+//   - detail-link discovery collapses duplicate hrefs per row (a compliant
+//     row may link the same /admin/lights/{id} twice — e.g. a thumbnail
+//     link plus the label link), so cleanup deletes each light exactly
+//     once;
+//   - every walk-page flow waits for the FIRST geolocation fix
+//     (#walk-pos / #walk-accuracy populated) before opening or submitting
+//     the form, and the photo preview waits for a decoded frame
+//     (naturalWidth > 0) — no submit or assertion races the watchPosition
+//     callback or the image load.
+//
+// Visual notes (what a correct screenshot shows) are inline per test and in
+// full in the README; the mobile projects (pixel-9, iphone-16, iphone-se-320
+// at 320x640) are the primary targets: "Add light here" sits in the bottom
+// third, the accuracy text is readable, the photo preview is correctly
+// oriented, and every tap target is at least 44 px tall.
+
+import { test, expect, type Page, type TestInfo } from '@playwright/test';
+import AxeBuilder from '@axe-core/playwright';
+import { loginAsAdmin } from './util/admin.js';
+import { hasAPP1, hasExifGps, jpegSize } from './util/images.js';
+
+test.use({
+  geolocation: { latitude: 42.7617, longitude: -71.0303, accuracy: 12 },
+  permissions: ['geolocation'],
+});
+
+// --- rerun-safety primitives (see the header comment) ---
+
+/** Fresh per Playwright invocation; combined with the project code it makes
+ * asset numbers unique across projects and across repeated runs against the
+ * same persistent test-run.db. */
+const RUN = Date.now().toString(36);
+
+function projectCode(testInfo: TestInfo): string {
+  switch (testInfo.project.name) {
+    case 'desktop-chromium':
+      return 'dc';
+    case 'pixel-9':
+      return 'p9';
+    case 'iphone-16':
+      return 'i16';
+    default:
+      return testInfo.project.name.replace(/[^a-z0-9]/g, '').slice(0, 4).toLowerCase() || 'x';
+  }
+}
+
+/** Dense per-project index (0..3): separates the pagination seed lanes. */
+function projectIndex(testInfo: TestInfo): number {
+  switch (testInfo.project.name) {
+    case 'desktop-chromium':
+      return 0;
+    case 'pixel-9':
+      return 1;
+    case 'iphone-16':
+      return 2;
+    default:
+      return 3;
+  }
+}
+
+/** `GP-017-<run>-<proj>-<tag>`: packet prefix preserved, value globally
+ * unique PER TEST (the tag distinguishes @A-202/@A-205/@A-206/@A-208 even
+ * when they share the GP-017 prefix), within the frozen 32-char
+ * [A-Za-z0-9-] asset_no budget. */
+function uniqAsset(prefix: string, testInfo: TestInfo, tag: string): string {
+  return `${prefix}-${RUN}-${projectCode(testInfo)}-${tag}`;
+}
+
+/** Deterministic per-(run, key) coordinates inside TOWN_BBOX with a wide
+ * margin: lat 42.7200..42.7500, lon -71.0800..-71.0500. Distinct keys land
+ * (for practical purposes) never within the 8 m unnumbered-duplicate radius
+ * of each other, so unnumbered creates cannot collide across tests, projects
+ * or runs. */
+function jittered(key: string): { lat: number; lon: number } {
+  let h = 2166136261;
+  for (const ch of `${RUN}|${key}`) {
+    h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0;
+  }
+  return {
+    lat: 42.72 + (h % 300) * 0.0001,
+    lon: -71.08 + ((h >>> 9) % 300) * 0.0001,
+  };
+}
+
+/** The add-light form's CSRF token (double-submit: the matching cookie lands
+ * in the shared context jar with this request). */
+async function csrfToken(page: Page): Promise<string> {
+  const res = await page.request.get('/admin/walk');
+  expect(res.status(), 'GET /admin/walk while fetching csrf_token').toBe(200);
+  const html = await res.text();
+  const input = html.match(/<input[^>]*name="csrf_token"[^>]*>/)?.[0];
+  const value = input?.match(/value="([^"]*)"/)?.[1];
+  expect(value, 'csrf_token parsed from the walk page form').toBeTruthy();
+  return value!;
+}
+
+/** Detail hrefs of every listed light whose row link mentions `label`
+ * (frozen: the row link's accessible name contains the label), deduped —
+ * a compliant row may carry the same href twice (thumbnail link + label
+ * link), and cleanup must POST each delete exactly once. */
+async function lightHrefsByLabel(page: Page, label: string): Promise<string[]> {
+  const hrefs = new Set<string>();
+  for (const target of ['/admin', '/admin?page=2']) {
+    const res = await page.request.get(target);
+    expect(res.status(), `GET ${target}`).toBe(200);
+    for (const m of (await res.text()).matchAll(
+      /<a\b[^>]*href="(\/admin\/lights\/\d+)"[^>]*>([\s\S]*?)<\/a>/g,
+    )) {
+      if (m[2].includes(label)) {
+        hrefs.add(m[1]);
+      }
+    }
+  }
+  return [...hrefs];
+}
+
+/** Soft-delete one light by detail href (frozen: 303). */
+async function deleteLight(page: Page, href: string, csrf: string): Promise<void> {
+  const res = await page.request.post(`${href}/delete`, {
+    multipart: { csrf_token: csrf },
+    maxRedirects: 0,
+  });
+  expect(res.status(), `POST ${href}/delete`).toBe(303);
+}
+
+/** Delete every light whose row mentions `label`, sweeping until none
+ * remain (deleting shifts later pages forward, so page-1 sweeps converge).
+ * Used as pre-clean (stale rows from failed earlier runs / retries) and as
+ * post-clean, keeping the shared DB tidy for the next test and the next
+ * run. */
+async function deleteAllByLabel(page: Page, label: string): Promise<void> {
+  for (let sweep = 0; sweep < 6; sweep++) {
+    const hrefs = await lightHrefsByLabel(page, label);
+    if (hrefs.length === 0) {
+      return;
+    }
+    const csrf = await csrfToken(page);
+    for (const href of hrefs) {
+      await deleteLight(page, href, csrf);
+    }
+  }
+  throw new Error(`cleanup: lights labelled "${label}" survived 6 delete sweeps`);
+}
