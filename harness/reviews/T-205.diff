+	t.Run("HX answers the Saved status fragment", func(t *testing.T) {
+		rec := adminPostMultipart(t, s, "/admin/lights", map[string]string{
+			CSRFTokenName: csrf, "label": "HX lamp", "kind": "park",
+			"lat": "42.7700", "lon": "-71.0400",
