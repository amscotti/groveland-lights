+		`value="7"`, `value="building" selected`, `data-bbox="42.7,-71.09,42.82,-70.96"`,
+	} {
+		if !strings.Contains(body, want) {
+			t.Errorf("rejection page lost %q; body:\n%s", want, body)
+		}
