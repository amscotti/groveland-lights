--- /dev/null
+++ b/web/templates/pages/admin-detail.html
@@ -0,0 +1,22 @@
+{{define "content"}}
+<section id="admin-detail">
+  <h1>{{.Label}}</h1>
+  {{if .PhotoSrc}}<p class="detail-photo"><img src="{{.PhotoSrc}}" alt="Photo of {{.Label}}" width="320"></p>{{end}}
+  <p>Position: <span id="light-pos">{{.Pos}}</span></p>
+  <p>Asset number: {{if .AssetNo}}<span class="light-asset">{{.AssetNo}}</span>{{else}}<span class="light-asset">—</span>{{end}}</p>
+  <p>Kind: {{.Kind}} · Status: <span class="status status-{{.Status}}"><span class="dot" aria-hidden="true"></span>{{.Status}}</span>{{if .Accuracy}} · Recorded accuracy: {{.Accuracy}} m{{end}}</p>
+  {{if .Alert}}<article role="alert"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 2 23 21H1Z" fill="#b3261e"></path><rect x="11" y="9" width="2" height="6" fill="#ffffff"></rect><rect x="11" y="17" width="2" height="2" fill="#ffffff"></rect></svg> <span>{{.Alert}}</span></article>{{end}}
+  <form method="post" action="{{.DetailURL}}">
+    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
+    <label for="edit-label">Label</label>
+    <input id="edit-label" name="label" type="text" maxlength="120" value="{{.Label}}" required>
+    <label for="edit-asset">Asset number</label>
+    <input id="edit-asset" name="asset_no" type="text" maxlength="32" value="{{.AssetNo}}" autocomplete="off">
+    <button type="submit">Save changes</button>
+  </form>
+  <form method="post" action="{{.DetailURL}}/delete">
+    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
+    <button type="submit" class="outline"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 2 23 21H1Z" fill="#b3261e"></path><rect x="11" y="9" width="2" height="6" fill="#ffffff"></rect><rect x="11" y="17" width="2" height="2" fill="#ffffff"></rect></svg> Delete light</button>
+  </form>
+</section>
+{{end}}
diff --git a/web/templates/pages/admin-list.html b/web/templates/pages/admin-list.html
new file mode 100644
index 0000000..945a89d
--- /dev/null
+++ b/web/templates/pages/admin-list.html
@@ -0,0 +1,26 @@
+{{define "content"}}
+<section id="admin-list">
+  <h1>Lights</h1>
+  <div id="rows">{{template "admin-rows-fragment" .}}</div>
+</section>
+{{end}}
+{{define "admin-rows-fragment"}}<!-- sync: partials/admin-rows.html -->
+  {{if .Rows}}
+  <table id="light-rows">
+    <tbody>
+    {{range .Rows}}<tr>
+      <td class="light-thumb"><a href="{{.DetailURL}}"><img src="{{.ImgSrc}}" alt="{{.ImgAlt}}" width="48" height="48"></a></td>
+      <td class="light-cell"><a href="{{.DetailURL}}">{{if .AssetNo}}<span class="light-asset">{{.AssetNo}}</span> {{end}}<strong class="light-label">{{.Label}}</strong></a> <span class="status status-{{.Status}}"><span class="dot" aria-hidden="true"></span>{{.Status}}</span></td>
+    </tr>
+    {{end}}</tbody>
+  </table>
+  {{else}}
+  <p>No lights recorded yet — walk the town to add the first one.</p>
+  {{end}}
+  {{if or .HasNewer .HasOlder}}
+  <form class="pager" method="get">
+    {{if .HasNewer}}<button type="submit" formaction="/admin/rows?page={{.NewerPage}}" hx-get="/admin/rows?page={{.NewerPage}}" hx-target="#rows" hx-swap="outerHTML">Newer</button>{{end}}
+    {{if .HasOlder}}<button type="submit" formaction="/admin/rows?page={{.OlderPage}}" hx-get="/admin/rows?page={{.OlderPage}}" hx-target="#rows" hx-swap="outerHTML">Older</button>{{end}}
+  </form>
+  {{end}}
+{{end}}
diff --git a/web/templates/pages/admin-login.html b/web/templates/pages/admin-login.html
