@@ -0,0 +1,561 @@
+// Admin UI (A-202/A-203/A-208/A-209): the walk-the-town page, the light
+// detail/edit page, the admin list with HTMX pagination and the soft-delete
+// flow. Every route is wrapped in AdminOnly; every request is parsed once at
+// the boundary into a typed struct and the handlers consult only those fields.
+// The create endpoint (POST /admin/lights) lives in admin_create.go.
+package web
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"html/template"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/amscotti/groveland-lights/internal/config"
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+func init() {
+	register(route{pattern: "GET /admin", handler: AdminOnly(adminList)})
+	register(route{pattern: "GET /admin/rows", handler: AdminOnly(adminRows)})
+	register(route{pattern: "GET /admin/walk", handler: AdminOnly(adminWalk)})
+	register(route{pattern: "GET /admin/lights/{id}", handler: AdminOnly(adminDetail)})
+	register(route{pattern: "POST /admin/lights/{id}", handler: AdminOnly(adminEdit)})
+	register(route{pattern: "POST /admin/lights/{id}/delete", handler: AdminOnly(adminDelete)})
+	installLoginPage()
+}
+
+// installLoginPage makes pages/admin-login.html the live login page without
+// touching auth.go (frozen for T-203): auth.go renders loginPageTmpl with nil
+// data, so the styled pipeline output is captured once at startup and installed
+// as that template. The frozen strings are unchanged; the served page now uses
+// base.html (pico.css, 44 px button) instead of auth.go's minimal markup.
+//
+// A parse/render failure is a build defect, not a runtime condition: panic with
+// the template name rather than silently serving the legacy minimal page, which
+// would make TestRenderAll/visual checks green against a page production never
+// serves.
+func installLoginPage() {
+	tpl, err := parseTemplates()
+	if err != nil {
+		panic("web: admin login: parse templates: " + err.Error())
+	}
+	var buf bytes.Buffer
+	if err := tpl.renderPage(&buf, "admin-login.html", pageData{Title: "Admin login"}); err != nil {
+		panic("web: admin login: render: " + err.Error())
+	}
+	parsed, err := template.New("admin-login").Parse(buf.String())
+	if err != nil {
+		panic("web: admin login: parse rendered page: " + err.Error())
+	}
+	loginPageTmpl = parsed
+}
+
+// adminPageSize is the frozen admin list page size: the 50 most recent
+// lights per page (A-209).
+const adminPageSize = 50
+
+// photoPlaceholder is the thumbnail for photo-less lights (frozen: placeholder
+// thumbnails are fine); a data URI keeps the row self-contained.
+const photoPlaceholder = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' fill='%23e8eaec'/%3E%3Ccircle cx='24' cy='19' r='10' fill='%239aa2ab'/%3E%3Crect x='20' y='29' width='8' height='10' rx='2' fill='%239aa2ab'/%3E%3C/svg%3E"
+
+// pageData is the chrome every admin page carries for base.html.
+type pageData struct {
+	Title   string
+	TestEnv bool
+}
+
+// --- admin list + rows fragment ---
+
+// rowView is one admin list row. ImgAlt follows the frozen format: asset
+// number + label for numbered lights, label alone for unnumbered ones.
+// ImgSrc is template.URL solely so the constant data-URI placeholder survives
+// html/template's URL scheme filter; values are server-minted, never user
+// input (photo paths come from the upload pipeline).
+type rowView struct {
+	DetailURL string
+	ImgSrc    template.URL //nolint:forbidigo // constant placeholder + pipeline paths only, never user input
+	ImgAlt    string
+	AssetNo   string
+	Label     string
+	Status    string
+}
+
+// listData backs pages/admin-list.html and partials/admin-rows.html (the
+// same data renders both: the full page and the HTMX fragment).
+type listData struct {
+	pageData
+	Rows      []rowView
+	OlderPage int
+	NewerPage int
+	HasOlder  bool
+	HasNewer  bool
+}
+
+// thumbAlt renders the frozen per-row alt format.
+func thumbAlt(l store.Light) string {
+	if l.AssetNo != nil && *l.AssetNo != "" {
+		return *l.AssetNo + " " + l.Label
+	}
+	return l.Label
+}
+
+// rowViewOf converts one stored light into its list row. Photo lookups are
+// per-row (admin scale is tens of lights, so the extra indexed read is fine).
+func (s *Server) rowViewOf(ctx context.Context, l store.Light) rowView {
+	src := template.URL(photoPlaceholder) //nolint:gosec // constant server-owned placeholder; scheme filter bypass is the point
+	if l.PhotoID != nil {
+		if p, err := s.Store.PhotoByID(ctx, *l.PhotoID); err == nil && p.Path != "" {
+			src = template.URL("/photos/" + p.Path) //nolint:gosec // server-minted pipeline path, never user input
+		}
+	}
+	asset := ""
+	if l.AssetNo != nil {
+		asset = *l.AssetNo
+	}
+	return rowView{
+		DetailURL: fmt.Sprintf("/admin/lights/%d", l.ID),
+		ImgSrc:    src,
+		ImgAlt:    thumbAlt(l),
+		AssetNo:   asset,
+		Label:     l.Label,
+		Status:    l.Status,
+	}
+}
+
+// listPage parses the one list query parameter: the 1-based page number.
+type listQuery struct{ Page int }
+
+func parseListQuery(r *http.Request) listQuery {
+	raw := r.URL.Query().Get("page")
+	page, err := strconv.Atoi(raw)
+	if err != nil || page < 1 {
+		page = 1
+	}
+	return listQuery{Page: page}
+}
+
+// storeReady guards the store-backed handlers the probe way: a nil store is
+// a wiring bug and answers 500.
+func (s *Server) storeReady(w http.ResponseWriter) bool {
+	if s.Store == nil {
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return false
+	}
+	return true
+}
+
+// recentRows fetches one page of rows plus one extra to detect an older page.
+func (s *Server) recentRows(ctx context.Context, page int) (listData, error) {
+	rows, err := s.Store.RecentLights(ctx, adminPageSize+1, (page-1)*adminPageSize)
+	if err != nil {
+		return listData{}, err
+	}
+	data := listData{
+		pageData:  pageData{Title: "Lights"},
+		NewerPage: page - 1,
+		OlderPage: page + 1,
+		HasNewer:  page > 1,
+	}
+	if len(rows) > adminPageSize {
+		data.HasOlder = true
+		rows = rows[:adminPageSize]
+	}
+	for _, l := range rows {
+		data.Rows = append(data.Rows, s.rowViewOf(ctx, l))
+	}
+	return data, nil
+}
+
+// adminList renders the full admin list page for page N.
+func adminList(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	if !s.storeReady(w) {
+		return
+	}
+	q := parseListQuery(r)
+	data, err := s.recentRows(r.Context(), q.Page)
+	if err != nil {
+		s.Log.Error("admin list", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	data.TestEnv = s.Cfg.IsTest()
+	if err := s.tpl.renderPage(w, "admin-list.html", data); err != nil {
+		s.Log.Error("admin list: render", "err", err)
+		// Header not yet sent by renderPage's buffering contract.
+		http.Error(w, "internal error", http.StatusInternalServerError)
+	}
+}
+
+// adminRows serves the HTMX rows fragment; without HX-Request it redirects to
+// the full page (frozen contract).
+func adminRows(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	if !s.storeReady(w) {
+		return
+	}
+	q := parseListQuery(r)
+	if r.Header.Get("HX-Request") == "" {
+		http.Redirect(w, r, fmt.Sprintf("/admin?page=%d", q.Page), http.StatusSeeOther)
+		return
+	}
+	data, err := s.recentRows(r.Context(), q.Page)
+	if err != nil {
+		s.Log.Error("admin rows", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	if err := s.tpl.renderPartial(w, "partials/admin-rows.html", data); err != nil {
+		s.Log.Error("admin rows: render", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+	}
+}
+
+// --- walk page ---
+
+// walkValues re-renders a submitted form after an error; strings because the
+// inputs carry strings.
+type walkValues struct {
+	Label     string
+	AssetNo   string
+	Kind      string
+	Lat       string
+	Lon       string
+	AccuracyM string
+}
+
+// dupView is the duplicate panel's view of the existing light.
+type dupView struct {
+	Label    string
+	AssetNo  string
+	Distance string
+	Numbered bool
+}
+
+// alertView backs partials/admin-alert.html — the small fragment the walk
+// form swaps into #dup-slot for successes (role=status "Saved") and for
+// server-side rejections (role=alert).
+type alertView struct {
+	Role    string
+	Message string
+}
+
+// walkPageData backs pages/admin-walk.html for the fresh render and for the
+// full-page error re-renders (no-JS clients).
+type walkPageData struct {
+	pageData
+	CSRFToken string
+	BBox      string
+	Values    walkValues
+	Alert     string
+	Dup       *dupView
+}
+
+// adminWalk renders the walk page with a fresh CSRF token.
+func adminWalk(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	token := IssueCSRFToken(w, r)
+	if token == "" {
+		return // IssueCSRFToken could not mint a token and answered 500.
+	}
+	data := walkPageData{
+		pageData:  pageData{Title: "Walk the town", TestEnv: s.Cfg.IsTest()},
+		CSRFToken: token,
+		BBox:      formatBBox(s.Cfg.TownBBox),
+		Values:    walkValues{Kind: string(store.KindPark)},
+	}
+	if err := s.tpl.renderPage(w, "admin-walk.html", data); err != nil {
+		s.Log.Error("admin walk: render", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+	}
+}
+
+// formatBBox renders the town bbox as "minLat,minLon,maxLat,maxLon" for the
+// walk page's client-side pre-flight (mirrors config.ParseBBox's input form).
+func formatBBox(b config.BBox) string {
+	return fmt.Sprintf("%g,%g,%g,%g", b.MinLat, b.MinLon, b.MaxLat, b.MaxLon)
+}
+
+// --- detail / edit / delete ---
+
+// lightIDParam is one {id} path value parsed at the boundary.
+type lightIDParam struct{ ID store.LightID }
+
+func parseLightID(r *http.Request) (lightIDParam, bool) {
+	raw := r.PathValue("id")
+	id, err := strconv.ParseInt(raw, 10, 64)
+	if err != nil || id < 1 {
+		return lightIDParam{}, false
+	}
+	return lightIDParam{ID: store.LightID(id)}, true
+}
+
+// detailData backs pages/admin-detail.html (the detail + edit + delete page).
+type detailData struct {
+	pageData
+	DetailURL string
+	Label     string
+	AssetNo   string
+	Kind      string
+	Status    string
+	Pos       string
+	Accuracy  string
+	PhotoSrc  string
+	CSRFToken string
+	Alert     string
+}
+
+// posString renders coordinates the frozen way: "lat, lon" at 6 decimal
+// places — the exact string the walk page's #pin-pos mirrors.
+func posString(lat, lon float64) string {
+	return strconv.FormatFloat(lat, 'f', 6, 64) + ", " + strconv.FormatFloat(lon, 'f', 6, 64)
+}
+
+// adminDetail renders one light's detail/edit page (404 once soft-deleted).
+func adminDetail(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	if !s.storeReady(w) {
+		return
+	}
+	id, ok := parseLightID(r)
+	if !ok {
+		http.NotFound(w, r)
+		return
+	}
+	light, err := s.Store.GetLight(r.Context(), id.ID)
+	if err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			http.NotFound(w, r)
+			return
+		}
+		s.Log.Error("admin detail", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	token := IssueCSRFToken(w, r)
+	if token == "" {
+		return
+	}
+	data := s.detailDataOf(r.Context(), light, token)
+	if err := s.tpl.renderPage(w, "admin-detail.html", data); err != nil {
+		s.Log.Error("admin detail: render", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+	}
+}
+
+// detailDataOf builds the detail page data for one light.
+func (s *Server) detailDataOf(ctx context.Context, light store.Light, token string) detailData {
+	data := detailData{
+		pageData:  pageData{Title: light.Label, TestEnv: s.Cfg.IsTest()},
+		DetailURL: fmt.Sprintf("/admin/lights/%d", light.ID),
+		Label:     light.Label,
+		Kind:      string(light.Kind),
+		Status:    light.Status,
+		Pos:       posString(light.Lat, light.Lon),
+		CSRFToken: token,
+	}
+	if light.AssetNo != nil {
+		data.AssetNo = *light.AssetNo
+	}
+	if light.AccuracyM != nil {
+		data.Accuracy = strconv.FormatFloat(*light.AccuracyM, 'f', -1, 64)
+	}
+	if light.PhotoID != nil {
+		if p, err := s.Store.PhotoByID(ctx, *light.PhotoID); err == nil {
+			data.PhotoSrc = "/photos/" + p.Path
+		}
+	}
+	return data
+}
+
+// lightEdit is a POST /admin/lights/{id} body parsed once at the boundary.
+// Nil fields mean "not sent" and keep their stored values (frozen: unspecified
+// fields keep values).
+type lightEdit struct {
+	CSRFToken string
+	Label     *string
+	AssetNo   *string
+}
+
+// parseLightEdit lifts the edit form into a typed struct. The admin UI posts
+// urlencoded; the drafts post multipart — both are accepted, read exactly
+// once. Handlers never touch the form after this parse.
+func parseLightEdit(r *http.Request) (lightEdit, bool) {
+	vals, ok := parseFormValues(r, adminEditMaxBody)
+	if !ok {
+		return lightEdit{}, false
+	}
+	e := lightEdit{CSRFToken: firstValue(vals, CSRFTokenName)}
+	if v, ok := vals["label"]; ok && len(v) > 0 {
+		e.Label = &v[0]
+	}
+	if v, ok := vals["asset_no"]; ok && len(v) > 0 {
+		e.AssetNo = &v[0]
+	}
+	return e, true
+}
+
+// adminEditMaxBody bounds edit/delete bodies (no uploads there).
+const adminEditMaxBody = 1 << 20
+
+// parseFormValues reads the request's form values exactly once, for
+// urlencoded (browser forms) and multipart (draft posts) bodies alike.
+func parseFormValues(r *http.Request, maxBody int64) (map[string][]string, bool) {
+	r.Body = http.MaxBytesReader(nil, r.Body, maxBody)
+	if strings.HasPrefix(r.Header.Get("Content-Type"), "multipart/") {
+		if err := r.ParseMultipartForm(maxBody); err != nil {
+			return nil, false
+		}
+		return r.MultipartForm.Value, true
+	}
+	if err := r.ParseForm(); err != nil {
+		return nil, false
+	}
+	return r.PostForm, true
+}
+
+// adminEdit applies a label/asset edit and redirects back to the detail page.
+func adminEdit(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	if !s.storeReady(w) {
+		return
+	}
+	id, ok := parseLightID(r)
+	if !ok {
+		http.NotFound(w, r)
+		return
+	}
+	edit, ok := parseLightEdit(r)
+	if !ok {
+		http.Error(w, "bad request", http.StatusBadRequest)
+		return
+	}
+	if err := VerifyCSRF(r, edit.CSRFToken); err != nil {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return
+	}
+	light, err := s.Store.GetLight(r.Context(), id.ID)
+	if err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			http.NotFound(w, r)
+			return
+		}
+		s.Log.Error("admin edit", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	csrf := IssueCSRFToken(w, r)
+	if csrf == "" {
+		return
+	}
+	newLabel, bad := validatedEditLabel(edit.Label, light.Label)
+	if bad != "" {
+		s.adminEditRejected(w, r, light, csrf, bad)
+		return
+	}
+	newAsset, bad := validatedEditAsset(edit.AssetNo, light.AssetNo)
+	if bad != "" {
+		s.adminEditRejected(w, r, light, csrf, bad)
+		return
+	}
+	if _, err := s.Store.EditLight(r.Context(), id.ID, newLabel, newAsset); err != nil {
+		if errors.Is(err, store.ErrDuplicateAssetNo) {
+			s.adminEditRejected(w, r, light, csrf, "That asset number is already in use")
+			return
+		}
+		s.Log.Error("admin edit", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	http.Redirect(w, r, fmt.Sprintf("/admin/lights/%d", id.ID), http.StatusSeeOther)
+}
+
+// validatedEditLabel picks the new label: sent values must be 1..120 chars.
+func validatedEditLabel(sent *string, current string) (string, string) {
+	if sent == nil {
+		return current, ""
+	}
+	label := strings.TrimSpace(*sent)
+	if len(label) < 1 || len(label) > 120 {
+		return "", "Label must be 1 to 120 characters"
+	}
+	return label, ""
+}
+
+// validatedEditAsset picks the new asset number: absent keeps the stored
+// value; an empty submission clears it; otherwise the frozen pattern applies.
+func validatedEditAsset(sent *string, current *string) (*string, string) {
+	if sent == nil {
+		return current, ""
+	}
+	asset := strings.TrimSpace(*sent)
+	if asset == "" {
+		return nil, ""
+	}
+	if !assetNoPattern.MatchString(asset) {
+		return nil, "Asset number must be 1-32 letters, digits or dashes"
+	}
+	return &asset, ""
+}
+
+// adminEditRejected re-renders the detail page with an alert and a 409.
+func (s *Server) adminEditRejected(w http.ResponseWriter, r *http.Request, light store.Light, csrf, message string) {
+	data := s.detailDataOf(r.Context(), light, csrf)
+	data.Alert = message
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.WriteHeader(http.StatusConflict)
+	if err := s.tpl.renderPage(w, "admin-detail.html", data); err != nil {
+		s.Log.Error("admin edit: render", "err", err)
+	}
+}
+
+// lightDelete is a POST /admin/lights/{id}/delete body parsed at the boundary.
+type lightDelete struct {
+	CSRFToken string
+}
+
+func parseLightDelete(r *http.Request) (lightDelete, bool) {
+	vals, ok := parseFormValues(r, adminEditMaxBody)
+	if !ok {
+		return lightDelete{}, false
+	}
+	return lightDelete{CSRFToken: firstValue(vals, CSRFTokenName)}, true
+}
+
+// adminDelete soft-deletes a light (frozen: 303 to /admin).
+func adminDelete(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	if !s.storeReady(w) {
+		return
+	}
+	id, ok := parseLightID(r)
+	if !ok {
+		http.NotFound(w, r)
+		return
+	}
+	del, ok := parseLightDelete(r)
+	if !ok {
+		http.Error(w, "bad request", http.StatusBadRequest)
+		return
+	}
+	if err := VerifyCSRF(r, del.CSRFToken); err != nil {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return
+	}
+	if err := s.Store.SoftDeleteLight(r.Context(), id.ID); err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			http.NotFound(w, r)
+			return
+		}
+		s.Log.Error("admin delete", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	http.Redirect(w, r, "/admin", http.StatusSeeOther)
+}
diff --git a/internal/web/admin_create.go b/internal/web/admin_create.go
new file mode 100644
index 0000000..fcfe162
--- /dev/null
+++ b/internal/web/admin_create.go
@@ -0,0 +1,454 @@
+// POST /admin/lights — the add-light submission (A-202/A-204/A-205/A-206).
+// Frozen check order: parse → CSRF → town bbox → photo validation →
+// duplicates. The one multipart parse happens in the boundary parser (after
+// upload.LimitBody); the photo pipeline reuses that form (upload.go's
+// documented contract). HTMX requests answer fragments the walk form swaps
+// into #dup-slot; every other client gets redirects or full error pages.
+package web
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/amscotti/groveland-lights/internal/geo"
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+func init() {
+	register(route{pattern: "POST /admin/lights", handler: AdminOnly(adminCreate)})
+}
+
+// adminFormMemory is the multipart parse budget; the body itself is capped at
+// MaxPhotoBytes by LimitBody before any parse (frozen order).
+const adminFormMemory = 32 << 20
+
+// assetNoPattern is the frozen asset-number rule: 1..32 of [A-Za-z0-9-].
+var assetNoPattern = regexp.MustCompile(`^[A-Za-z0-9-]{1,32}$`)
+
+// badSubmission is a parsed request that failed validation, carrying the
+// response status and the user-facing message.
+type badSubmission struct {
+	status  int
+	message string
+}
+
+func bad(status int, message string) *badSubmission {
+	return &badSubmission{status: status, message: message}
+}
+
+// walkSubmission is a POST /admin/lights body parsed once at the boundary;
+// after parseWalkSubmission no handler touches the form. The Raw fields hold
+// exactly what the admin typed, so every error re-render can echo them; the
+// typed fields are filled by validateWalkSubmission only after CSRF passes.
+type walkSubmission struct {
+	CSRFToken string
+	LabelRaw  string
+	AssetRaw  string
+	KindRaw   string
+	LatRaw    string
+	LonRaw    string
+	AccRaw    string
+	DupRaw    string
+
+	Label     string
+	AssetNo   *string
+	Kind      store.Kind
+	Lat       float64
+	Lon       float64
+	AccuracyM *float64
+	DupChoice string
+}
+
+// parseWalkSubmission lifts the multipart form into a typed submission.
+// LimitBody(r) MUST have been called first (the handler does); the parse here
+// is the request's single multipart parse, and the photo pipeline reuses it.
+// This step is syntactic only: field validation runs after CSRF so the frozen
+// parse → CSRF → bbox order always answers 403 to a bad token.
+func parseWalkSubmission(r *http.Request) (walkSubmission, *badSubmission) {
+	if err := r.ParseMultipartForm(adminFormMemory); err != nil {
+		// A body over the LimitBody cap surfaces as *http.MaxBytesError and
+		// is reported through the photo wording (413); anything else is a
+		// malformed multipart request.
+		status, message := PhotoProblem(err)
+		if status == http.StatusInternalServerError {
+			return walkSubmission{}, bad(http.StatusBadRequest, "bad request")
+		}
+		return walkSubmission{}, bad(status, message)
+	}
+	v := r.MultipartForm.Value
+	val := func(key string) string { return firstValue(v, key) }
+	return walkSubmission{
+		CSRFToken: strings.TrimSpace(val(CSRFTokenName)),
+		LabelRaw:  val("label"),
+		AssetRaw:  val("asset_no"),
+		KindRaw:   val("kind"),
+		LatRaw:    val("lat"),
+		LonRaw:    val("lon"),
+		AccRaw:    val("accuracy_m"),
+		DupRaw:    val("dup_choice"),
+	}, nil
+}
+
+// validateWalkSubmission parses the required fields (label, asset number, kind,
+// position) and the optional ones (accuracy, dup_choice) into their typed form.
+// It runs after CSRF verification.
+func validateWalkSubmission(sub *walkSubmission) *badSubmission {
+	sub.Label = strings.TrimSpace(sub.LabelRaw)
+	if len(sub.Label) < 1 || len(sub.Label) > 120 {
+		return bad(http.StatusUnprocessableEntity, "Label must be 1 to 120 characters")
+	}
+	if raw := strings.TrimSpace(sub.AssetRaw); raw != "" {
+		if !assetNoPattern.MatchString(raw) {
+			return bad(http.StatusUnprocessableEntity, "Asset number must be 1-32 letters, digits or dashes")
+		}
+		asset := raw
+		sub.AssetNo = &asset
+	}
+	kind, err := store.ParseKind(strings.TrimSpace(sub.KindRaw))
+	if err != nil || kind == store.KindStreet {
+		// street is reserved for the later import; the walk form offers
+		// park|building only (frozen reconciliation 3).
+		return bad(http.StatusUnprocessableEntity, "Choose a kind: park or building")
+	}
+	sub.Kind = kind
+	lat, lon, perr := parseLatLon(sub.LatRaw, sub.LonRaw)
+	if perr != nil {
+		return bad(http.StatusUnprocessableEntity, "A position is required — wait for a fix or type one in")
+	}
+	sub.Lat, sub.Lon = lat, lon
+	if raw := strings.TrimSpace(sub.AccRaw); raw != "" {
+		acc, err := strconv.ParseFloat(raw, 64)
+		if err != nil || acc < 0 || !finite(acc) {
+			return bad(http.StatusUnprocessableEntity, "Accuracy must be a metre value of zero or more")
+		}
+		sub.AccuracyM = &acc
+	}
+	switch dc := sub.DupRaw; dc {
+	case "", "merge", "save":
+		sub.DupChoice = dc
+	default:
+		return bad(http.StatusUnprocessableEntity, "Unknown duplicate choice")
+	}
+	return nil
+}
+
+// firstValue returns the first value of a parsed form field ("" when absent).
+func firstValue(v map[string][]string, key string) string {
+	if vs := v[key]; len(vs) > 0 {
+		return vs[0]
+	}
+	return ""
+}
+
+// parseLatLon converts the two position fields, refusing NaN/Inf.
+func parseLatLon(latRaw, lonRaw string) (float64, float64, error) {
+	lat, err := strconv.ParseFloat(strings.TrimSpace(latRaw), 64)
+	if err != nil {
+		return 0, 0, err
+	}
+	lon, err := strconv.ParseFloat(strings.TrimSpace(lonRaw), 64)
+	if err != nil {
+		return 0, 0, err
+	}
+	if !finite(lat) || !finite(lon) || lat < -90 || lat > 90 || lon < -180 || lon > 180 {
+		return 0, 0, fmt.Errorf("position out of range")
+	}
+	return lat, lon, nil
+}
+
+// finite reports whether f is a usable (non-NaN, non-Inf) float.
+func finite(f float64) bool {
+	return !math.IsNaN(f) && !math.IsInf(f, 0)
+}
+
+// adminCreate runs the frozen check order over one parsed submission.
+func adminCreate(w http.ResponseWriter, r *http.Request) {
+	s := serverFrom(r.Context())
+	if !s.storeReady(w) {
+		return
+	}
+	LimitBody(r) // FIRST: before anything reads the body
+	sub, perr := parseWalkSubmission(r)
+	if perr != nil {
+		s.walkReject(w, r, nil, perr.status, perr.message)
+		return
+	}
+	if !s.verifyWalkCSRF(w, r, sub) {
+		return
+	}
+	if perr := validateWalkSubmission(&sub); perr != nil {
+		s.walkReject(w, r, &sub, perr.status, perr.message)
+		return
+	}
+	if !s.Cfg.TownBBox.Contains(sub.Lat, sub.Lon) {
+		s.walkReject(w, r, &sub, http.StatusUnprocessableEntity,
+			"That position is outside Groveland town bounds")
+		return
+	}
+	photo, ok := s.walkPhoto(w, r, &sub)
+	if !ok {
+		return
+	}
+	if s.respondWalkDuplicate(w, r, sub, photo) {
+		return
+	}
+	s.createWalkLight(w, r, sub, photo)
+}
+
+// verifyWalkCSRF answers 403 for a bad or missing token. It runs before any
+// semantic field validation (frozen parse → CSRF → bbox order).
+func (s *Server) verifyWalkCSRF(w http.ResponseWriter, r *http.Request, sub walkSubmission) bool {
+	if err := VerifyCSRF(r, sub.CSRFToken); err != nil {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return false
+	}
+	return true
+}
+
+// walkPhoto runs the photo pipeline and maps its errors. ok is false when a
+// response has already been written.
+func (s *Server) walkPhoto(w http.ResponseWriter, r *http.Request, sub *walkSubmission) (*UploadedPhoto, bool) {
+	photo, err := s.Photo(r) // reuses the boundary parse; validates the upload
+	if err == nil {
+		return photo, true
+	}
+	status, message := PhotoProblem(err)
+	if status == http.StatusInternalServerError {
+		s.Log.Error("admin create: photo", "err", err)
+		http.Error(w, "internal error", status)
+		return nil, false
+	}
+	s.walkReject(w, r, sub, status, message)
+	return nil, false
+}
+
+// respondWalkDuplicate handles a classified duplicate. It reports true when it
+// has written the response and the caller must stop.
+func (s *Server) respondWalkDuplicate(w http.ResponseWriter, r *http.Request, sub walkSubmission, photo *UploadedPhoto) bool {
+	decision, dup, err := s.classifyDuplicate(r, sub)
+	if err != nil {
+		s.Log.Error("admin create: duplicate lookup", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return true
+	}
+	if !dup {
+		return false
+	}
+	switch {
+	case sub.DupChoice == "merge":
+		s.mergeDuplicate(w, r, sub, decision, photo)
+		return true
+	case sub.DupChoice == "save" && decision.Numbered:
+		// Frozen: save-anyway is unnumbered-only.
+		s.walkReject(w, r, &sub, http.StatusUnprocessableEntity,
+			"This fixture has an asset number — merge it or cancel instead")
+		return true
+	case sub.DupChoice == "":
+		s.respondDuplicate(w, r, sub, decision)
+		return true
+	default:
+		// dup_choice=save on an unnumbered duplicate: fall through and create.
+		return false
+	}
+}
+
+// createWalkLight inserts the light and answers success (or the race panel).
+func (s *Server) createWalkLight(w http.ResponseWriter, r *http.Request, sub walkSubmission, photo *UploadedPhoto) {
+	_, err := s.Store.CreateLight(r.Context(), store.NewLight{
+		AssetNo:   sub.AssetNo,
+		Kind:      sub.Kind,
+		Label:     sub.Label,
+		Lat:       sub.Lat,
+		Lon:       sub.Lon,
+		AccuracyM: sub.AccuracyM,
+		PhotoID:   photoIDOf(photo),
+	})
+	if err == nil {
+		s.respondWalkOK(w, r)
+		return
+	}
+	if errors.Is(err, store.ErrDuplicateAssetNo) && s.respondCreateRace(w, r, sub) {
+		return
+	}
+	s.Log.Error("admin create", "err", err)
+	http.Error(w, "internal error", http.StatusInternalServerError)
+}
+
+// respondCreateRace shows the numbered duplicate panel for the row that won a
+// concurrent same-asset-number create.
+func (s *Server) respondCreateRace(w http.ResponseWriter, r *http.Request, sub walkSubmission) bool {
+	existing, err := s.Store.LightByAssetNo(r.Context(), *sub.AssetNo)
+	if err != nil {
+		return false
+	}
+	s.respondDuplicate(w, r, sub, geo.DupDecision{
+		Numbered:   true,
+		ExistingID: int64(existing.ID),
+		DistanceM:  geo.DistanceM(geo.Point{Lat: sub.Lat, Lon: sub.Lon}, geo.Point{Lat: existing.Lat, Lon: existing.Lon}),
+	})
+	return true
+}
+
+// photoIDOf converts an optional uploaded photo into its typed id reference.
+func photoIDOf(photo *UploadedPhoto) *store.PhotoID {
+	if photo == nil {
+		return nil
+	}
+	id := photo.ID
+	return &id
+}
+
+// classifyDuplicate gathers the near candidates (plus the asset-number hit,
+// which is distance-independent) and lets geo.ClassifyDuplicate decide. A
+// store failure is returned to the caller, never swallowed: falling through
+// would create a light with duplicate detection silently disabled.
+func (s *Server) classifyDuplicate(r *http.Request, sub walkSubmission) (geo.DupDecision, bool, error) {
+	newPt := geo.Point{Lat: sub.Lat, Lon: sub.Lon}
+	var candidates []geo.Candidate
+	if sub.AssetNo != nil {
+		existing, err := s.Store.LightByAssetNo(r.Context(), *sub.AssetNo)
+		switch {
+		case err == nil:
+			candidates = append(candidates, geo.Candidate{
+				LightID: int64(existing.ID),
+				AssetNo: *sub.AssetNo,
+				Point:   geo.Point{Lat: existing.Lat, Lon: existing.Lon},
+			})
+		case errors.Is(err, store.ErrNotFound):
+			// No numbered duplicate; the proximity check still runs.
+		default:
+			return geo.DupDecision{}, false, fmt.Errorf("light by asset_no: %w", err)
+		}
+	}
+	nearby, err := s.Store.NearbyLights(r.Context(), sub.Lat, sub.Lon, geo.NumberedRadiusM)
+	if err != nil {
+		return geo.DupDecision{}, false, fmt.Errorf("nearby lights: %w", err)
+	}
+	for _, l := range nearby {
+		asset := ""
+		if l.AssetNo != nil {
+			asset = *l.AssetNo
+		}
+		candidates = append(candidates, geo.Candidate{
+			LightID: int64(l.ID),
+			AssetNo: asset,
+			Point:   geo.Point{Lat: l.Lat, Lon: l.Lon},
+		})
+	}
+	newAsset := ""
+	if sub.AssetNo != nil {
+		newAsset = *sub.AssetNo
+	}
+	decision, dup := geo.ClassifyDuplicate(newAsset, newPt, candidates)
+	return decision, dup, nil
+}
+
+// respondDuplicate answers 409 with the duplicate panel: the fragment for
+// HTMX (the walk form swaps it into #dup-slot), the full walk page otherwise.
+func (s *Server) respondDuplicate(w http.ResponseWriter, r *http.Request, sub walkSubmission, decision geo.DupDecision) {
+	existing, err := s.Store.GetLight(r.Context(), store.LightID(decision.ExistingID))
+	if err != nil {
+		s.Log.Error("admin create: dup lookup", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	asset := ""
+	if existing.AssetNo != nil {
+		asset = *existing.AssetNo
+	}
+	view := dupView{
+		Label:    existing.Label,
+		AssetNo:  asset,
+		Distance: humanDistance(decision.DistanceM),
+		Numbered: decision.Numbered,
+	}
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	if r.Header.Get("HX-Request") != "" {
+		w.WriteHeader(http.StatusConflict)
+		if err := s.tpl.renderPartial(w, "partials/admin-dup.html", view); err != nil {
+			s.Log.Error("admin create: dup render", "err", err)
+		}
+		return
+	}
+	data := s.walkPageDataOf(w, r, sub)
+	data.Dup = &view
+	w.WriteHeader(http.StatusConflict)
+	if err := s.tpl.renderPage(w, "admin-walk.html", data); err != nil {
+		s.Log.Error("admin create: dup page render", "err", err)
+	}
+}
+
+// walkReject answers a validation failure with the frozen status: an alert
+// fragment for HTMX, the re-rendered walk page (values kept) otherwise. A
+// parse failure has no submission to echo, but the page it returns is still a
+// usable form: it carries a fresh CSRF token and the bbox.
+func (s *Server) walkReject(w http.ResponseWriter, r *http.Request, sub *walkSubmission, status int, message string) {
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	if r.Header.Get("HX-Request") != "" {
+		w.WriteHeader(status)
+		if err := s.tpl.renderPartial(w, "partials/admin-alert.html", alertView{Role: "alert", Message: message}); err != nil {
+			s.Log.Error("admin create: reject render", "err", err)
+		}
+		return
+	}
+	submitted := walkSubmission{Kind: store.KindPark, KindRaw: string(store.KindPark)}
+	if sub != nil {
+		submitted = *sub
+	}
+	data := s.walkPageDataOf(w, r, submitted)
+	if data.CSRFToken == "" {
+		return // IssueCSRFToken already answered 500.
+	}
+	data.Alert = message
+	w.WriteHeader(status)
+	if err := s.tpl.renderPage(w, "admin-walk.html", data); err != nil {
+		s.Log.Error("admin create: reject page render", "err", err)
+	}
+}
+
+// walkPageDataOf rebuilds the walk page data from a parsed submission so the
+// no-JS error re-render keeps the admin's typed values exactly as submitted
+// (Raw fields), even when validation stopped before every typed field was
+// filled. A parse failure has no submission, so the caller passes park.
+func (s *Server) walkPageDataOf(w http.ResponseWriter, r *http.Request, sub walkSubmission) walkPageData {
+	return walkPageData{
+		pageData:  pageData{Title: "Walk the town", TestEnv: s.Cfg.IsTest()},
+		CSRFToken: IssueCSRFToken(w, r),
+		BBox:      formatBBox(s.Cfg.TownBBox),
+		Values: walkValues{
+			Label:     sub.LabelRaw,
+			AssetNo:   sub.AssetRaw,
+			Kind:      sub.KindRaw,
+			Lat:       sub.LatRaw,
+			Lon:       sub.LonRaw,
+			AccuracyM: sub.AccRaw,
+		},
+	}
+}
+
+// respondWalkOK answers success: role=status "Saved" fragment for HTMX, the
+// frozen 303 to /admin for everyone else.
+func (s *Server) respondWalkOK(w http.ResponseWriter, r *http.Request) {
+	if r.Header.Get("HX-Request") != "" {
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		if err := s.tpl.renderPartial(w, "partials/admin-alert.html", alertView{Role: "status", Message: "Saved"}); err != nil {
+			s.Log.Error("admin create: ok render", "err", err)
+			http.Error(w, "internal error", http.StatusInternalServerError)
+		}
+		return
+	}
+	http.Redirect(w, r, "/admin", http.StatusSeeOther)
+}
+
+// humanDistance renders a duplicate distance for the panel.
+func humanDistance(m float64) string {
+	if m < 10 {
+		return fmt.Sprintf("%.1f m away", m)
+	}
+	return fmt.Sprintf("%.0f m away", m)
+}
diff --git a/internal/web/admin_merge.go b/internal/web/admin_merge.go
new file mode 100644
index 0000000..a9ac7e8
--- /dev/null
+++ b/internal/web/admin_merge.go
@@ -0,0 +1,61 @@
+// Duplicate merge (A-205): dup_choice=merge applies the new submission's label
+// AND photo onto the surviving row, never creating a second row.
+package web
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/amscotti/groveland-lights/internal/geo"
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+// mergeDuplicate applies the new submission's label and photo onto the
+// existing row. With a photo the write goes through store.EditLightPhoto,
+// which updates the label, asset number and photo in one transaction: if the
+// photo write fails, the label is rolled back too. Without a photo the plain
+// EditLight path is used.
+//
+// The replaced photo row/file is intentionally not deleted here: A-207's
+// no-stray-file contract covers a FAILED upload (the pipeline removes its own
+// file), while garbage-collecting a replaced, still-served photo is a separate
+// retention decision.
+func (s *Server) mergeDuplicate(w http.ResponseWriter, r *http.Request, sub walkSubmission, decision geo.DupDecision, photo *UploadedPhoto) {
+	existing, err := s.Store.GetLight(r.Context(), store.LightID(decision.ExistingID))
+	if err != nil {
+		if !errors.Is(err, store.ErrNotFound) {
+			s.Log.Error("admin merge: read existing", "err", err)
+			http.Error(w, "internal error", http.StatusInternalServerError)
+			return
+		}
+		// The duplicate vanished between the check and the merge: save as a
+		// plain new light instead (keeping the uploaded photo).
+		_, cerr := s.Store.CreateLight(r.Context(), store.NewLight{
+			AssetNo:   sub.AssetNo,
+			Kind:      sub.Kind,
+			Label:     sub.Label,
+			Lat:       sub.Lat,
+			Lon:       sub.Lon,
+			AccuracyM: sub.AccuracyM,
+			PhotoID:   photoIDOf(photo),
+		})
+		if cerr != nil {
+			s.Log.Error("admin merge: create", "err", cerr)
+			http.Error(w, "internal error", http.StatusInternalServerError)
+			return
+		}
+		s.respondWalkOK(w, r)
+		return
+	}
+	if photo != nil {
+		_, err = s.Store.EditLightPhoto(r.Context(), existing.ID, sub.Label, existing.AssetNo, photo.ID)
+	} else {
+		_, err = s.Store.EditLight(r.Context(), existing.ID, sub.Label, existing.AssetNo)
+	}
+	if err != nil {
+		s.Log.Error("admin merge", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	s.respondWalkOK(w, r)
+}
diff --git a/internal/web/admin_test.go b/internal/web/admin_test.go
new file mode 100644
index 0000000..9c0bf55
--- /dev/null
+++ b/internal/web/admin_test.go
@@ -0,0 +1,1154 @@
+package web
+
+// Admin UI handler tests (A-202/A-203/A-208/A-209). Every route is exercised
+// through the full middleware chain against a real temp-file store (the same
+// wiring as production), with a minted admin session cookie and matching
+// double-submit CSRF pair. Assertions mirror the frozen contract in
+// acceptance/drafts (status codes, frozen strings, the #rows fragment root,
+// the 303s without HX-Request).
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"io"
+	"log/slog"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/amscotti/groveland-lights/internal/config"
+	"github.com/amscotti/groveland-lights/internal/store"
+)
+
+// adminTownBBox mirrors the frozen TOWN_BBOX the drafts use.
+var adminTownBBox = config.BBox{MinLat: 42.70, MinLon: -71.09, MaxLat: 42.82, MaxLon: -70.96}
+
+// newAdminServer builds a Server on a real temp DB with an admin session
+// already minted; it returns the server and the session cookie value.
+func newAdminServer(t *testing.T) (*Server, string) {
+	t.Helper()
+	dbPath := filepath.Join(t.TempDir(), "admin.db")
+	db, err := store.Open(context.Background(), dbPath)
+	if err != nil {
+		t.Fatalf("store.Open: %v", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	cfg := testConfig(config.EnvTest)
+	cfg.DBPath = dbPath
+	cfg.SessionKey = []byte("0123456789abcdef0123456789abcdef")
+	cfg.TownBBox = adminTownBBox
+	cfg.PhotoDir = filepath.Join(t.TempDir(), "photos")
+	s, err := New(cfg, slog.New(slog.NewTextHandler(io.Discard, nil)), db)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	uid, err := db.EnsureAdminUser(context.Background())
+	if err != nil {
+		t.Fatalf("EnsureAdminUser: %v", err)
+	}
+	sid, err := db.CreateSession(context.Background(), uid, "admin")
+	if err != nil {
+		t.Fatalf("CreateSession: %v", err)
+	}
+	return s, sessionValue(cfg.SessionKey, sid)
+}
+
+// adminDo runs one request through the full chain with the session cookie.
+func adminDo(t *testing.T, s *Server, method, target, session string, hx bool, body io.Reader, contentType string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequestWithContext(context.Background(), method, target, body)
+	if contentType != "" {
+		req.Header.Set("Content-Type", contentType)
+	}
+	if hx {
+		req.Header.Set("HX-Request", "true")
+	}
+	if session != "" {
+		req.AddCookie(&http.Cookie{Name: SessionCookieName, Value: session})
+	}
+	rec := httptest.NewRecorder()
+	s.Handler().ServeHTTP(rec, req)
+	return rec
+}
+
+// adminGet is adminDo for GETs (optionally HX).
+func adminGet(t *testing.T, s *Server, target, session string, hx bool) *httptest.ResponseRecorder {
+	t.Helper()
+	return adminDo(t, s, http.MethodGet, target, session, hx, nil, "")
+}
+
+// adminPostMultipart builds and runs one multipart POST. csrfCookie ("" for
+// none) completes the double-submit pair with the csrf_token form field.
+func adminPostMultipart(t *testing.T, s *Server, target string, fields map[string]string, fileField, fileName string, fileData []byte, session, csrfCookie string, hx bool) *httptest.ResponseRecorder {
+	t.Helper()
+	var body strings.Builder
+	w := multipart.NewWriter(&body)
+	for k, v := range fields {
+		if err := w.WriteField(k, v); err != nil {
+			t.Fatalf("field %s: %v", k, err)
+		}
+	}
+	if fileField != "" {
+		fw, err := w.CreateFormFile(fileField, fileName)
+		if err != nil {
+			t.Fatalf("form file: %v", err)
+		}
+		if _, err := fw.Write(fileData); err != nil {
+			t.Fatalf("file write: %v", err)
+		}
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("multipart close: %v", err)
+	}
+	req := httptest.NewRequestWithContext(context.Background(), http.MethodPost, target, strings.NewReader(body.String()))
+	req.Header.Set("Content-Type", w.FormDataContentType())
+	if hx {
+		req.Header.Set("HX-Request", "true")
+	}
+	if session != "" {
+		req.AddCookie(&http.Cookie{Name: SessionCookieName, Value: session})
+	}
+	if csrfCookie != "" {
+		req.AddCookie(&http.Cookie{Name: CSRFTokenName, Value: csrfCookie})
+	}
+	rec := httptest.NewRecorder()
+	s.Handler().ServeHTTP(rec, req)
+	return rec
+}
+
+// adminCSRF mints a fresh CSRF token (cookie value == form value).
+func adminCSRF(t *testing.T) string {
+	t.Helper()
+	return mustCSRFToken(t)
+}
+
+// adminFixture reads one of the testdata photo fixtures.
+func adminFixture(t *testing.T, name string) []byte {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join("..", "..", "testdata", "photos", name))
+	if err != nil {
+		t.Fatalf("fixture %s: %v", name, err)
+	}
+	return b
+}
+
+// postCreate is the common create call (label/kind/lat/lon + optional asset);
+// the CSRF pair matches.
+func postCreate(t *testing.T, s *Server, session, csrf string, fields map[string]string) *httptest.ResponseRecorder {
+	t.Helper()
+	all := map[string]string{CSRFTokenName: csrf}
+	for k, v := range fields {
+		all[k] = v
+	}
+	return adminPostMultipart(t, s, "/admin/lights", all, "", "", nil, session, csrf, false)
+}
+
+// createLight asserts a 303 create and returns nothing (list assertions follow).
+func createLight(t *testing.T, s *Server, session, csrf string, fields map[string]string) {
+	t.Helper()
+	rec := postCreate(t, s, session, csrf, fields)
+	if rec.Code != http.StatusSeeOther {
+		t.Fatalf("create %v: status %d, want 303; body:\n%s", fields, rec.Code, rec.Body.String())
+	}
+	if loc := rec.Header().Get("Location"); loc != "/admin" {
+		t.Fatalf("create Location = %q, want /admin", loc)
+	}
+}
+
+// reRowsRoot matches a fragment whose ROOT element carries id="rows" (frozen).
+var reRowsRoot = regexp.MustCompile(`\A\s*<[a-zA-Z][^>]*\bid="rows"`)
+
+// reCSRFInput captures the rendered hidden csrf_token input's value.
+var reCSRFInput = regexp.MustCompile(`<input[^>]*name="csrf_token"[^>]*value="([^"]+)"`)
+
+// csrfInputValue extracts the form's double-submit token. ok is false when the
+// rendered form carries no token (the caller decides whether that is a failure).
+func csrfInputValue(body string) (value string, ok bool) {
+	m := reCSRFInput.FindStringSubmatch(body)
+	if m == nil {
+		return "", false
+	}
+	return m[1], true
+}
+
+// reArticle matches one rendered <article> element, including its content.
+var reArticle = regexp.MustCompile(`(?s)<article\b[^>]*>.*?</article>`)
+
+// alertWithMessage extracts the rendered <article> element that carries
+// message. The walk page also renders a permanently hidden, empty
+// #walk-alert article, so a bare role="alert" search would match an element
+// that never shows the rejection.
+func alertWithMessage(t *testing.T, body, message string) string {
+	t.Helper()
+	for _, el := range reArticle.FindAllString(body, -1) {
+		if strings.Contains(el, message) {
+			return el
+		}
+	}
+	t.Fatalf("no rendered <article> carries %q; body:\n%s", message, body)
+	return ""
+}
+
+// assertVisibleAlert asserts the alert that carries message is a visible
+// role=alert element (not the walk page's hidden status placeholder) in both
+// the full-page and HX responses.
+func assertVisibleAlert(t *testing.T, body, message string) {
+	t.Helper()
+	el := alertWithMessage(t, body, message)
+	open := el[:strings.Index(el, ">")+1]
+	if !strings.Contains(open, `role="alert"`) {
+		t.Errorf("alert carrying %q is not role=alert; element:\n%s", message, el)
+	}
+	if regexp.MustCompile(`\bhidden\b`).MatchString(open) {
+		t.Errorf("alert carrying %q is hidden; element:\n%s", message, el)
+	}
+	if !strings.Contains(el, message) {
+		t.Errorf("alert element does not show %q; element:\n%s", message, el)
+	}
+}
+
+// reForm matches one rendered <form> element, including its content.
+var reForm = regexp.MustCompile(`(?s)<form\b[^>]*>.*?</form>`)
+
+// pagerFormOf extracts the pager GET form whose button carries control
+// ("Older"/"Newer"), so the hidden page input is proven to be inside the form
+// that submits to /admin/rows (a stray input elsewhere cannot satisfy it).
+func pagerFormOf(t *testing.T, body, control string) string {
+	t.Helper()
+	for _, f := range reForm.FindAllString(body, -1) {
+		open := f[:strings.Index(f, ">")+1]
+		if !strings.Contains(open, `method="get"`) || !strings.Contains(open, `action="/admin/rows"`) {
+			continue
+		}
+		if strings.Contains(f, ">"+control+"</button>") {
+			return f
+		}
+	}
+	t.Fatalf("no GET /admin/rows pager form with a %s button; body:\n%s", control, body)
+	return ""
+}
+
+// assertPagerPageInput pins the no-JS pager contract: the control's form is a
+// GET to /admin/rows and carries the target page in a hidden input, so a
+// browser submission does not fall back to page 1.
+func assertPagerPageInput(t *testing.T, body, control string, page int) {
+	t.Helper()
+	form := pagerFormOf(t, body, control)
+	want := fmt.Sprintf(`<input type="hidden" name="page" value="%d">`, page)
+	if !strings.Contains(form, want) {
+		t.Errorf("%s pager form lacks %s; form:\n%s", control, want, form)
+	}
+	if !strings.Contains(form, fmt.Sprintf(`hx-get="/admin/rows?page=%d"`, page)) {
+		t.Errorf("%s pager form lacks the matching hx-get; form:\n%s", control, form)
+	}
+}
+
+// dupPanelOf extracts the exact #dup-panel element from a rendered page, so
+// assertions cannot accidentally match text from the rest of the form (the
+// submitted label appears in the label input too).
+func dupPanelOf(t *testing.T, body string) string {
+	t.Helper()
+	start := strings.Index(body, `id="dup-panel"`)
+	if start < 0 {
+		t.Fatalf("no #dup-panel in body:\n%s", body)
+	}
+	end := strings.Index(body[start:], "</article>")
+	if end < 0 {
+		t.Fatalf("#dup-panel is not closed:\n%s", body)
+	}
+	return body[start : start+end+len("</article>")]
+}
+
+// adminRowCount counts the rendered list rows (one <tr> per light).
+func adminRowCount(body string) int { return strings.Count(body, "<tr>") }
+
+// assertLampPage checks one rendered list page holds exactly the expected
+// boundary lamps (and none of the excluded ones).
+func assertLampPage(t *testing.T, page, body string, present, absent []int) {
+	t.Helper()
+	if got := adminRowCount(body); got != len(present) {
+		t.Errorf("%s rows = %d, want exactly %d", page, got, len(present))
+	}
+	for _, i := range present {
+		if !strings.Contains(body, padLamp(i)) {
+			t.Errorf("%s lacks %q", page, padLamp(i))
+		}
+	}
+	for _, i := range absent {
+		if strings.Contains(body, padLamp(i)) {
+			t.Errorf("%s unexpectedly shows %q", page, padLamp(i))
+		}
+	}
+}
