+}
+
+// --- walk page ---
+
+func TestAdminWalkPage(t *testing.T) {
+	s, session := newAdminServer(t)
+	rec := adminGet(t, s, "/admin/walk", session, false)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200; body:\n%s", rec.Code, rec.Body.String())
