+  <h2>Possible duplicate</h2>
+  <p>An existing light looks the same: <strong>{{.Label}}</strong>{{if .AssetNo}} (asset number {{.AssetNo}}){{end}}, about {{.Distance}} from this position.</p>
+  <p class="dup-actions">
+    <button type="submit" name="dup_choice" value="merge">Merge</button>
+    {{if not .Numbered}}<button type="submit" name="dup_choice" value="save">Save anyway</button>
+    {{else}}<a href="/admin/walk">Cancel</a>{{end}}
+  </p>
+</article>
diff --git a/web/templates/partials/admin-rows.html b/web/templates/partials/admin-rows.html
new file mode 100644
