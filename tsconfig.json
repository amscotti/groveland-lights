{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "web/static/js/**/*.js",
    "web/static/js/**/*.d.ts",
    "acceptance/e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
